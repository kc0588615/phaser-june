# VPS Docker environment variables
# Copy to .env on VPS: cp .env.vps.example .env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_DB=phaser_june

# PgBouncer's TLS certificate domain (DNS A record to the server): certbot and the renewal hook use it
# (docs/DEPLOY.md, setup step 4). The data lives in the named Docker volume `pgdata`, not a host path.
DB_DOMAIN=db.critterconnect.org
