    },
    "size": {
      "value": "small",
      "note": "It weighs 750 to 1,400 g, with a shell 15 to 24 cm long.",
      "source": "adw"
    },
    "diet": {
      "value": "mixed",
      "note": "Half its food is crayfish. It also eats insects, fish, frogs, snails and water plants.",
      "source": "adw"
    },
    "birth": {
      "value": "eggs",
      "source": "adw"
    },
    "lifespan": {
      "value": "long",
