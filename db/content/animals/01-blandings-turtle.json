  "traits": {
    "covering": {
      "value": "shell",
      "note": "Its smooth, dark shell is sprinkled with yellow spots.",
      "source": "adw"
    },
    "size": {
      "value": "small",
      "note": "It weighs 750 to 1,400 g, with a shell 15 to 24 cm long.",
      "source": "adw"
    },
    "diet": {
      "value": "insects",
      "note": "Half its food is crustaceans, including crayfish. It also eats insects, snails, fish, frogs and water plants.",
      "source": "adw"
    },
    "trees": {
      "value": "no",
      "note": "It stays low, and at most climbs onto logs to rest.",
      "source": "adw"
    },
    "birth": {
      "value": "eggs",
      "source": "adw"
    },
    "lifespan": {
      "value": "long",
      "note": "Wild Blanding's turtles can live more than 70 years.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "It has yellow scales on its legs and tail.",
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its bottom shell has a hinge, so it can close up tight.",
      "tags": [
        "hinged_shell"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in shallow marshes, ponds and bogs full of water plants.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It often climbs out of the water to bask on logs.",
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Whether its eggs hatch as males or females depends on how warm the nest is.",
      "tags": [
        "temperature_sex"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Main threats: wetlands lost to farms and houses, and many turtles die crossing roads.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its face has bold markings in a contrasting color, such as patches, rings or lines.",
      "tags": [
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its coat or skin is covered with spots.",
      "tags": [
        "spots"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its belly is spotted.",
      "tags": [
        "spotted_belly"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has a patch of contrasting color on its throat.",
      "tags": [
        "throat_patch"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "As an adult, it has no teeth at all.",
      "tags": [
        "toothless"
      ],
      "source": "britannica",
      "url": "https://www.britannica.com/animal/turtle-reptile"
    },
    {
      "category": "morphology",
      "text": "It has webbed feet: skin joins its toes.",
      "tags": [
        "webbed_feet"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its legs are yellow.",
      "tags": [
        "yellow_legs"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It digs into the ground on land, for example making burrows, tunnels or dens, or digging itself down into soil or sand.",
      "tags": [
        "burrower"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes a loud hissing sound.",
      "tags": [
        "hisses"
      ],
      "source": "government",
      "url": "https://semspub.epa.gov/work/03/130484.pdf"
    },
    {
      "category": "behavior",
      "text": "It rests on the bottom of a river, lake or pond, under water.",
      "tags": [
        "rests_on_bottom"
      ],
      "source": "government",
      "url": "https://files.dnr.state.mn.us/eco/nongame/projects/consgrant_reports/1998/1998_sajwaj_etal.pdf"
    },
    {
      "category": "diet",
      "text": "It often eats animals that are already dead.",
      "tags": [
        "scavenger"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It swims well or often.",
      "tags": [
        "swimmer"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It rests or sleeps through the winter, inactive for weeks or months.",
      "tags": [
        "winter_rest"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It often rests in the sun to warm its body.",
      "tags": [
        "basker"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It sleeps, hides or raises its young in burrows or dens that other animals dug.",
      "tags": [
        "borrowed_burrows"
      ],
      "source": "literature",
      "url": "https://chelonian.org/wp-content/uploads/file/CCB%20Vol%201%20No%203%20%281995%29/Butler_and_Graham_1995.pdf"
    },
    {
      "category": "habitat",
      "text": "It lives in rivers or lakes with soft, sandy or muddy bottoms.",
      "tags": [
        "sandy_bottoms"
      ],
      "source": "government",
      "url": "https://semspub.epa.gov/work/03/130484.pdf"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly where snow covers the ground for weeks or months in winter.",
      "tags": [
        "snowy_winters"
      ],
      "source": "government",
      "url": "https://pubs.usgs.gov/of/2021/1104/d/ofr20211104d.pdf"
    },
    {
      "category": "habitat",
      "text": "In some places it lives in or near human settlements, such as towns, villages, gardens, parks or plantations.",
      "tags": [
        "town_dweller"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives or breeds in shallow, still water, such as marshes, ponds, pools or bogs.",
      "tags": [
        "shallow_wetlands"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "It lays its eggs out of the water, on land or underground.",
      "tags": [
        "eggs_on_land"
      ],
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "The older a Blanding's turtle gets, the better its chance of surviving each year.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "To court a female, a male squirts water from his mouth onto her head.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Hatchlings are 3 to 4 cm long and weigh just 6 to 10 g.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Hatchlings find their way to water by smell, following the scent trails of other young turtles.",
      "source": "adw"
    }
  ],
