  "clues": [
    {
      "category": "morphology",
      "text": "It has yellow scales on its legs and tail.",
      "tags": [
        "yellow_scales"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its bottom shell has a hinge, so it can close up tight.",
      "tags": [
        "hinged_shell"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in shallow marshes, ponds and bogs full of water plants.",
      "tags": [
        "shallow_wetlands"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It often climbs out of the water to bask on logs.",
      "tags": [
        "basker"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Whether its eggs hatch as males or females depends on how warm the nest is.",
      "tags": [
        "temperature_sex"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Main threats: wetlands lost to farms and houses, and many turtles die crossing roads.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "The older a Blanding's turtle gets, the better its chance of surviving each year.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "To court a female, a male squirts water from his mouth onto her head.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Hatchlings are 3 to 4 cm long and weigh just 6 to 10 g.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Hatchlings find their way to water by smell, following the scent trails of other young turtles.",
      "source": "adw"
    }
  ],
