  "clues": [
    {
      "category": "morphology",
      "text": "Its snout ends in a soft, pointy tip.",
      "tags": [
        "pointed_snout"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It can be brown or bright green, matching the ground where it sits.",
      "tags": [
        "camouflage"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its belly is black with big white spots.",
      "tags": [
        "spotted_belly"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in the fallen leaves of southern beech forests.",
      "tags": [
        "leaf_litter"
      ],
      "source": "iucn"
    },
    {
      "category": "reproduction",
      "text": "The father carries the tadpoles inside his throat pouch until they turn into froglets.",
      "tags": [
        "father_carries_young"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Main threats: forests cut down or replaced with pine plantations, and chytrid, a fungus that kills frogs.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Zoos in Chile and Germany breed it as a backup population.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Charles Darwin found this frog in Chile during his voyage on HMS Beagle.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "The tadpoles live in their father's throat pouch for about 6 weeks, then hop out as tiny frogs.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "Its whole home can be just 1 to 3 square meters: about the size of a bath mat.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "In the cold months it shelters under logs and moss.",
      "source": "amphibiaweb"
    },
    {
      "category": "life_description",
      "text": "Females lay their eggs in damp leaf litter on the forest floor.",
      "source": "amphibiaweb"
    },
    {
      "category": "threat",
      "text": "It has vanished from many places where it was common until the 1980s.",
      "source": "iucn"
    }
  ],
