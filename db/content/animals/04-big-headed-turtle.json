  "clues": [
    {
      "category": "morphology",
      "text": "Its head is huge and can't be pulled into its shell.",
      "tags": [
        "huge_head"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its long, muscular tail is almost as long as its shell.",
      "tags": [
        "long_tail"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It is a poor swimmer but a good rock climber.",
      "tags": [
        "climber"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in cool, fast, rocky mountain streams.",
      "tags": [
        "cold_streams"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Main threat: huge numbers are caught for food and the pet trade.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its hooked jaws can bite hard and hang on for a long time.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "The top of its skull is solid bone, unlike most turtles' skulls.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Its white eggs look like small bird eggs.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "At night it searches the stream bottom and bushes along the banks for food.",
      "source": "adw"
    }
  ],
