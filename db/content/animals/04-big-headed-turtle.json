  "traits": {
    "covering": {
      "value": "shell",
      "note": "Its shell is flat, with a squared-off front.",
      "source": "adw"
    },
    "diet": {
      "value": "mixed",
      "note": "Fruit is what it eats most often, followed by insects, other plant matter, crabs and molluscs.",
      "source": "iucn"
    },
    "activity": {
      "value": "night",
      "note": "By day it hides under rocks or underwater.",
      "source": "adw"
    },
    "trees": {
      "value": "no",
      "note": "It hides under gravel or in cracks between stones.",
      "source": "literature",
      "url": "https://web.archive.org/web/20110522230829/http://www.unc.edu/~dtkirkpa/stuff/bigheads.html"
    },
    "birth": {
      "value": "eggs",
      "source": "adw"
    },
    "young": {
      "value": "one",
      "note": "It lays just 1 or 2 eggs at a time.",
      "source": "adw"
    },
    "lifespan": {
      "value": "long",
      "note": "A generation takes about 30 years.",
      "source": "iucn"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "Its head is huge and can't be pulled into its shell.",
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its long, muscular tail is almost as long as its shell.",
      "tags": [
        "long_tail"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It is a poor swimmer but a good rock climber.",
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in cool, fast, rocky mountain streams.",
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Main threat: huge numbers are caught for food and the pet trade.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its colors or pattern help it blend in with its surroundings, so it is hard to see.",
      "tags": [
        "camouflage"
      ],
      "source": "literature",
      "url": "https://doi.org/10.1002/ece3.10633"
    },
    {
      "category": "morphology",
      "text": "It has five claws on each front foot.",
      "tags": [
        "five_front_claws"
      ],
      "source": "government",
      "url": "https://chm-thai.onep.go.th/wp-content/uploads/2021/10/ONEP_V14.pdf"
    },
    {
      "category": "morphology",
      "text": "Its shell is very flat and low, not domed.",
      "tags": [
        "flat_shell"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It bites or chews with unusual force for its size.",
      "tags": [
        "strong_bite"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "As an adult, it has no teeth at all.",
      "tags": [
        "toothless"
      ],
      "source": "britannica",
      "url": "https://www.britannica.com/animal/turtle-reptile"
    },
    {
      "category": "morphology",
      "text": "It has webbed feet: skin joins its toes.",
      "tags": [
        "webbed_feet"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its head is very large for its body.",
      "tags": [
        "huge_head"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It hides or rests buried under sand, mud, gravel, soil or fallen leaves.",
      "tags": [
        "buries_itself"
      ],
      "source": "literature",
      "url": "http://www.unc.edu/~dtkirkpa/stuff/bigheads.html"
    },
    {
      "category": "behavior",
      "text": "It climbs up big rocks, boulders or cliffs.",
      "tags": [
        "climbs_boulders"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Fruit is a main or favorite part of its food.",
      "tags": [
        "fruit_eater"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It rests on the bottom of a river, lake or pond, under water.",
      "tags": [
        "rests_on_bottom"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in or by fast-flowing streams or rivers with rushing water.",
      "tags": [
        "fast_streams"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in or by streams that run through forest.",
      "tags": [
        "forest_streams"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives in or by cool or cold, clear streams.",
      "tags": [
        "cold_streams"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "It lays its eggs out of the water, on land or underground.",
      "tags": [
        "eggs_on_land"
      ],
      "source": "literature",
      "url": "https://oaj.fupress.net/index.php/ah/article/view/1728"
    },
    {
      "category": "behavior",
      "text": "It hides in narrow cracks and gaps between or under rocks.",
      "tags": [
        "crevice_hider"
      ],
      "source": "literature",
      "url": "http://www.unc.edu/~dtkirkpa/stuff/bigheads.html"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its hooked jaws can bite hard and hang on for a long time.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "The top of its skull is solid bone, unlike most turtles' skulls.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Its white eggs look like small bird eggs.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "At night it searches the stream bottom and bushes along the banks for food.",
      "source": "adw"
    }
  ],
