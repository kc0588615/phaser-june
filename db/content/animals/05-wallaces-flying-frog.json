  "clues": [
    {
      "category": "morphology",
      "text": "Its huge hands and feet are webbed right to the fingertips.",
      "tags": [
        "webbed_feet"
      ],
      "source": "amphibiaweb"
    },
    {
      "category": "morphology",
      "text": "It is shiny green, with yellow sides and yellow toe pads.",
      "tags": [
        "bright_green"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It glides from tree to tree, up to about 15 m.",
      "tags": [
        "glider"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It lives high in the trees and only climbs down to breed.",
      "tags": [
        "tree_dweller"
      ],
      "source": "iucn"
    },
    {
      "category": "reproduction",
      "text": "It makes a foam nest on leaves over a pool, and the tadpoles drop into the water.",
      "tags": [
        "foam_nest"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It breeds at rain pools and even muddy animal wallows in the forest.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Main threat: lowland rainforest cut down for timber and oil palm plantations.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is named after Alfred Russel Wallace, who came up with the idea of evolution by natural selection at the same time as Darwin.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Flaps of skin on its arms and legs work like a sail when it glides.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes a long, low approach before landing, then grips the tree with sticky toe pads.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "The female whips a fluid into foam with her back legs and lays her eggs inside it.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "A few are caught for the pet trade, but that isn't a big threat.",
      "source": "iucn"
    }
  ],
