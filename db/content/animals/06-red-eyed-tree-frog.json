  "clues": [
    {
      "category": "morphology",
      "text": "It has big, bulging red eyes.",
      "tags": [
        "red_eyes"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It is leaf green, with blue and yellow stripes on its sides and orange feet.",
      "tags": [
        "bright_green",
        "orange_feet"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It lives in trees near ponds.",
      "tags": [
        "tree_dweller"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "When a predator comes close, it flashes its bright eyes to startle it.",
      "tags": [
        "startle_display"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "It lays its eggs on a leaf over water, so the tadpoles drop into the pond when they hatch.",
      "tags": [
        "eggs_over_water"
      ],
      "source": "amphibiaweb"
    },
    {
      "category": "conservation",
      "text": "Main threats: forest loss, capture for the pet trade, and disease.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Its international trade has been controlled since 2008 (CITES Appendix II).",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "If a snake or wasp attacks its eggs, the tadpoles can hatch up to 30% early and escape into the water.",
      "source": "amphibiaweb"
    },
    {
      "category": "key_fact",
      "text": "Males shake branches to send vibration messages to other frogs.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Young froglets can change their skin color between day and night.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Tadpoles live in the water for several weeks before they turn into froglets.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "In some countries, wild frogs are caught for the pet trade.",
      "source": "iucn"
    }
  ],
