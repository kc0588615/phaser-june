  "clues": [
    {
      "category": "morphology",
      "text": "In the breeding season, males grow thin, hair-like frills of skin on their sides and thighs.",
      "tags": [
        "hair_like_frills"
      ],
      "source": "wikipedia"
    },
    {
      "category": "morphology",
      "text": "Males grow to about 13 cm long, bigger than females.",
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "If it is grabbed, it can push sharp bone claws out through the skin of its toes.",
      "tags": [
        "bone_claws"
      ],
      "source": "wikipedia"
    },
    {
      "category": "habitat",
      "text": "It lives by fast-flowing rivers in the rainforest; its tadpoles live in rushing water at the foot of waterfalls.",
      "tags": [
        "fast_streams"
      ],
      "source": "iucn"
    },
    {
      "category": "reproduction",
      "text": "Eggs are laid on rocks in streams, and the male stays to guard them.",
      "tags": [
        "egg_guarding"
      ],
      "source": "wikipedia"
    },
    {
      "category": "conservation",
      "text": "Main threats: people hunt it for food, and forests are cleared for farms.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "The 'hairs' are full of tiny blood vessels. They help the male take in extra oxygen through his skin while he guards his eggs underwater.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Its nicknames are the horror frog and the wolverine frog, because of its hidden claws.",
      "source": "wikipedia"
    },
    {
      "category": "life_description",
      "text": "Its tadpoles are hunters, with several rows of tiny horny teeth.",
      "source": "wikipedia"
    },
    {
      "category": "threat",
      "text": "Near villages it is often rare, because people catch and eat the frogs and even their tadpoles.",
      "source": "iucn"
    },
    {
      "category": "threat",
      "text": "Traders in Cameroon collect some for the pet trade in the USA and Japan.",
      "source": "iucn"
    }
  ],
