      "value": "no",
      "note": "It stays down low, hiding under stones.",
      "source": "iucn"
    },
    "birth": {
      "value": "eggs",
      "source": "adw"
    },
    "lifespan": {
      "value": "medium",
      "note": "It can live at least 14 years, a long life for a frog.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "Males have a short 'tail' that is really a body part used for mating.",
      "tags": [
        "tail_organ"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its pupils are vertical slits.",
      "tags": [
        "vertical_pupils"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its toe tips are hard, for gripping rocks in rushing water.",
      "tags": [
        "hard_toe_tips"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "In the breeding season, males' forearms grow much bigger.",
      "source": "amphibiaweb"
    },
    {
      "category": "morphology",
      "text": "Its back can be cream, gray, red or black, often with dark streaks and blotches.",
      "source": "amphibiaweb"
    },
    {
      "category": "habitat",
      "text": "It lives in clear, cold mountain streams beside old forests.",
      "tags": [
        "cold_streams"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It can't call like most frogs: it has no vocal sac and no eardrums.",
      "tags": [
        "voiceless"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Its tadpoles hold on to rocks in fast water with a suction-cup mouth.",
      "tags": [
        "sucker_mouth_tadpoles"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Unlike most frogs, its eggs are fertilized inside the female's body.",
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "In Canada it is listed as a species of Special Concern.",
      "source": "government"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its family is one of the oldest frog lineages. The only other member is the Rocky Mountain tailed frog.",
      "source": "government"
    },
    {
      "category": "key_fact",
      "text": "Fertilizing its eggs inside the body makes sure they get fertilized in fast-flowing streams.",
      "source": "amphibiaweb"
    },
    {
      "category": "life_description",
      "text": "Tadpoles take 1 to 4 years to become frogs.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Females glue their eggs under big rocks in the stream. They hatch about 6 weeks later.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Young frogs take 7 to 8 years to be ready to breed.",
      "source": "amphibiaweb"
    },
    {
      "category": "behavior",
      "text": "It stays active through the winter, just more slowly.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It spends most of its life in water, but adults may come onto land to hunt on cool, wet nights.",
      "source": "amphibiaweb"
    },
    {
      "category": "threat",
      "text": "Logging near its streams may be a major cause of its decline. More frogs live where a strip of trees is left along the bank.",
      "source": "amphibiaweb"
    }
  ],
