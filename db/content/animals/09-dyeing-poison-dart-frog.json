      "value": "eggs",
      "source": "iucn"
    },
    "lifespan": {
      "value": "medium",
      "note": "It lives 4 to 6 years in the wild and up to 12 in zoos.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "Its bright colors, like blue, or yellow and black, warn predators that it is poisonous.",
      "tags": [
        "warning_colors"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It hops around on the forest floor near small streams.",
      "tags": [
        "forest_floor"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It defends its patch by calling, chasing and wrestling other frogs.",
      "tags": [
        "territorial"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "The father carries the tadpoles on his back to puddles or water-filled tree holes.",
      "tags": [
        "father_carries_young"
      ],
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Main threats: illegal collecting for the pet trade, farming and logging.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "It breeds easily in zoos, and zoos all over the world keep it.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its poison comes from the ants and other small prey it eats. Frogs raised on crickets in zoos aren't poisonous.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "The spot pattern on each frog is different, like a fingerprint.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "It is one of the most traded frogs in the world.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "Its tadpoles eat eggs that their mother lays just to feed them.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Eggs hatch in about two weeks; tadpoles become froglets 10 to 12 weeks later.",
      "source": "adw"
    }
  ],
