  "clues": [
    {
      "category": "morphology",
      "text": "Its body is very flat, with a triangle-shaped head.",
      "tags": [
        "flat_body"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Each fingertip ends in a tiny star shape.",
      "tags": [
        "star_fingers"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its tiny black eyes have no eyelids.",
      "tags": [
        "lidless_eyes"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It almost never leaves the water, resting on the bottom of murky ponds.",
      "tags": [
        "fully_aquatic"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It has no tongue: it feels for food with its fingers and stuffs it into its mouth.",
      "tags": [
        "no_tongue"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Its eggs sink into pockets in the mother's back and hatch there as tiny toads, with no tadpole stage.",
      "tags": [
        "mother_carries_young",
        "no_tadpoles"
      ],
      "source": "government"
    },
    {
      "category": "conservation",
      "text": "No major threats: it is widespread, with plenty of rainforest left.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its babies climb out of little pockets in their mother's back after 3 to 4 months.",
      "source": "government"
    },
    {
      "category": "key_fact",
      "text": "Males call to females with sharp clicks instead of croaks.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It swims up to the surface for air about every half hour.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "While mating, the pair flip and loop through the water as the eggs roll onto the female's back.",
      "source": "adw"
    }
  ],
