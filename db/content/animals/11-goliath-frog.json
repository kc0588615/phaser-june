  "clues": [
    {
      "category": "morphology",
      "text": "It is the biggest frog on Earth, up to 32 cm long.",
      "tags": [
        "giant_frog"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its eyes can be almost 2.5 cm across.",
      "tags": [
        "large_eyes"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It needs big, clean, fast-flowing rivers deep in the rainforest.",
      "tags": [
        "fast_streams"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It rests on wet, mossy rocks by rivers and waterfalls.",
      "tags": [
        "rock_basker"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It has no vocal sac, so it can't croak. Males whistle with their mouths open instead.",
      "tags": [
        "voiceless"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Main threat: hunting for food. Its numbers fell by more than 70% in 15 years.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Some were shipped to the USA for zoos, pets and even frog-jumping races.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "A big one weighs about as much as a newborn baby.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "Its tadpoles eat only one kind of water plant, which grows near waterfalls.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Young goliath frogs spend most of their time underwater.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Its eggs stick to plants on the river bottom. Tadpoles grow for about 75 to 90 days.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "New roads to plantations make its rivers easier for hunters to reach.",
      "source": "iucn"
    }
  ],
