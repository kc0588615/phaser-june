  "clues": [
    {
      "category": "morphology",
      "text": "Its other name is the sunburst turtle, for the spikes around the edge of its shell.",
      "tags": [
        "spiky_shell"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives by hilly forest streams, in flooded forest and in lowland swamps.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "By day it hides buried in fallen leaves, where its brown shell blends in.",
      "tags": [
        "leaf_litter",
        "camouflage",
        "buries_itself"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Spiny_turtle"
    },
    {
      "category": "diet",
      "text": "Fallen fruit is one of its favorite foods.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Spiny_turtle"
    },
    {
      "category": "conservation",
      "text": "Main threats: collecting for food and pets, and rainforest cleared for farms.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Its numbers dropped by 50 to 80% over the last 51 years.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its face has bold markings in a contrasting color, such as patches, rings or lines.",
      "tags": [
        "face_markings"
      ],
      "source": "government",
      "url": "https://www.nparks.gov.sg/florafaunaweb/fauna/0/6/06"
    },
    {
      "category": "morphology",
      "text": "It has five claws on each front foot.",
      "tags": [
        "five_front_claws"
      ],
      "source": "literature",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Articles/Taylor_1920.pdf"
    },
    {
      "category": "morphology",
      "text": "Its shell or skin has lines that spread out like stars.",
      "tags": [
        "star_pattern"
      ],
      "source": "literature",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Articles/Taylor_1920.pdf"
    },
    {
      "category": "morphology",
      "text": "Its tail is very short, just a stub.",
      "tags": [
        "stubby_tail"
      ],
      "source": "literature",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Articles/Taylor_1920.pdf"
    },
    {
      "category": "morphology",
      "text": "As an adult, it has no teeth at all.",
      "tags": [
        "toothless"
      ],
      "source": "britannica"
    },
    {
      "category": "morphology",
      "text": "It has webbed feet: skin joins its toes.",
      "tags": [
        "webbed_feet"
      ],
      "source": "literature",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Articles/Taylor_1920.pdf"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "government",
      "url": "https://www.nparks.gov.sg/florafaunaweb/fauna/0/6/06"
    },
    {
      "category": "diet",
      "text": "It spreads plant seeds to new places by eating them, often in fruit, and passing them in its droppings.",
      "tags": [
        "seed_spreader"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Spiny_turtle"
    },
    {
      "category": "diet",
      "text": "Fruit is a main or favorite part of its food.",
      "tags": [
        "fruit_eater"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Spiny_turtle"
    },
    {
      "category": "habitat",
      "text": "It lives in or by cool or cold, clear streams.",
      "tags": [
        "cold_streams"
      ],
      "source": "literature",
      "url": "https://turtles.linnaeus.naturalis.nl/linnaeus_ng/app/views/species/taxon.php?id=8070"
    },
    {
      "category": "habitat",
      "text": "It lives in or by streams that run through forest.",
      "tags": [
        "forest_streams"
      ],
      "source": "iucn"
    },
    {
      "category": "reproduction",
      "text": "It lays its eggs out of the water, on land or underground.",
      "tags": [
        "eggs_on_land"
      ],
      "source": "literature",
      "url": "https://turtles.linnaeus.naturalis.nl/linnaeus_ng/app/views/species/taxon.php?id=8070"
    },
    {
      "category": "behavior",
      "text": "It lives and feeds on the forest floor, and rarely if ever climbs up into the trees.",
      "tags": [
        "forest_floor"
      ],
      "source": "government",
      "url": "https://www.nparks.gov.sg/florafaunaweb/fauna/0/6/06"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "In Indonesia only 250 can be caught legally each year, and only small ones under 20 cm.",
      "source": "iucn"
    },
    {
      "category": "life_description",
      "text": "It starts breeding at about 7 years old.",
      "source": "iucn"
    },
    {
      "category": "threat",
      "text": "Many die while they are being caught and shipped.",
      "source": "iucn"
    }
  ],
