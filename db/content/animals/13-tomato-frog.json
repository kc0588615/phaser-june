  "clues": [
    {
      "category": "morphology",
      "text": "It is bright reddish orange, like a ripe tomato.",
      "tags": [
        "red_orange"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Females are bigger and brighter than males, which look more brown.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "When grabbed, its skin oozes a sticky white glue that can gum up a predator's mouth and eyes.",
      "tags": [
        "sticky_skin"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It likes to burrow into soft ground.",
      "tags": [
        "burrower"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives near the coast, even in drainage ditches and gardens in town.",
      "tags": [
        "town_dweller"
      ],
      "source": "iucn"
    },
    {
      "category": "reproduction",
      "text": "It breeds after heavy rain, in ditches, swamps and still pools.",
      "tags": [
        "rain_breeder"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Collecting wild frogs for pets has stopped; pet tomato frogs are now bred in captivity.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its red color depends partly on what it eats.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "Young frogs start out black, turn tan, then turn red as they grow up.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Its skin glue is among the stickiest made by any amphibian.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Pollution of the ponds where it breeds could harm it.",
      "source": "iucn"
    }
  ],
