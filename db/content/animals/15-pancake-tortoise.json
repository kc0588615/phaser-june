  "traits": {
    "covering": {
      "value": "shell",
      "note": "Unlike most tortoises, its shell bends when pressed.",
      "source": "iucn"
    },
    "size": {
      "value": "small",
      "note": "Its shell grows to about 18 cm long, and it rarely weighs more than 500 g.",
      "source": "iucn"
    },
    "diet": {
      "value": "mixed",
      "note": "It eats herbs, succulent plants and flowers, plus the odd beetle.",
      "source": "iucn"
    },
    "activity": {
      "value": "day",
      "note": "It comes out to feed in the early morning.",
      "source": "iucn"
    },
    "trees": {
      "value": "no",
      "note": "It squeezes into narrow cracks to hide.",
      "source": "iucn"
    },
    "birth": {
      "value": "eggs",
      "source": "iucn"
    },
    "young": {
      "value": "one",
      "note": "A female lays one large egg a year, rarely two.",
      "source": "tftsg"
    },
    "lifespan": {
      "value": "long",
      "note": "Pancake tortoises have lived more than 25 years in zoos.",
      "source": "tftsg"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "Its shell is so flat it looks like a pancake.",
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives on rocky hills called kopjes that rise out of the savanna.",
      "tags": [
        "kopjes"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It hides in narrow cracks between and under slabs of rock.",
      "tags": [
        "crevice_hider"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It is a good climber: some have been found in cracks high up on tall boulders.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Main threats: collecting for the pet trade, and breaking up the rocks it hides in.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "International trade in it has been controlled since 1975 (CITES Appendix II).",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its colors or pattern help it blend in with its surroundings, so it is hard to see.",
      "tags": [
        "camouflage"
      ],
      "source": "tftsg",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Accounts/crm_5_107_tornieri_v1_2018.pdf"
    },
    {
      "category": "morphology",
      "text": "Its body is very flat, much wider than it is tall.",
      "tags": [
        "flat_body"
      ],
      "source": "tftsg"
    },
    {
      "category": "morphology",
      "text": "Its shell or skin has lines that spread out like stars.",
      "tags": [
        "star_pattern"
      ],
      "source": "tftsg",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Accounts/crm_5_107_tornieri_v1_2018.pdf"
    },
    {
      "category": "morphology",
      "text": "As an adult, it has no teeth at all.",
      "tags": [
        "toothless"
      ],
      "source": "sdzwa",
      "url": "https://animals.sandiegozoo.org/animals/galapagos-giant-tortoise"
    },
    {
      "category": "morphology",
      "text": "Its shell is very flat and low, not domed.",
      "tags": [
        "flat_shell"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It often rests in the sun to warm its body.",
      "tags": [
        "basker"
      ],
      "source": "literature",
      "url": "https://chelonian.org/wp-content/uploads/file/CCB%20Vol%202%20No%201%20%281996%29/Moll_and_Klemens_1996.pdf"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "literature",
      "url": "https://chelonian.org/wp-content/uploads/file/CCB%20Vol%202%20No%201%20%281996%29/Moll_and_Klemens_1996.pdf"
    },
    {
      "category": "diet",
      "text": "It mostly eats grass or other low plants that it crops from the ground.",
      "tags": [
        "grazer"
      ],
      "source": "literature",
      "url": "https://chelonian.org/wp-content/uploads/file/CCB%20Vol%202%20No%201%20%281996%29/Moll_and_Klemens_1996.pdf"
    },
    {
      "category": "diet",
      "text": "It can go days or longer without drinking, getting most of its water from its food.",
      "tags": [
        "rarely_drinks"
      ],
      "source": "smithsonian",
      "url": "https://nationalzoo.si.edu/animals/african-pancake-tortoise"
    },
    {
      "category": "behavior",
      "text": "It climbs up big rocks, boulders or cliffs.",
      "tags": [
        "climbs_boulders"
      ],
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its shell is soft and bendy because the bones underneath have open gaps. That lets it squeeze into narrow cracks.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "Collecting and habitat damage cut its numbers by about 80% in 30 years.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "In Kenya, about 95% of pancake tortoises live outside protected areas.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It keeps to a small home area and returns to the same rock cracks again and again.",
      "source": "iucn"
    },
    {
      "category": "life_description",
      "text": "The egg is laid at the start of the rainy season. Hatchlings are 3 to 5 cm long.",
      "source": "iucn"
    },
    {
      "category": "life_description",
      "text": "It takes 5 to 9 years to grow up.",
      "source": "tftsg"
    },
    {
      "category": "threat",
      "text": "Collectors sometimes pry apart the rocks it hides in, destroying the cracks it needs.",
      "source": "iucn"
    }
  ],
