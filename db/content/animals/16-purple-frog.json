  "clues": [
    {
      "category": "morphology",
      "text": "Its body is round and puffy, with a small head and a pointy, pig-like snout.",
      "tags": [
        "pointed_snout",
        "round_body"
      ],
      "source": "amphibiaweb"
    },
    {
      "category": "morphology",
      "text": "It is dark purplish gray.",
      "tags": [
        "purple_gray"
      ],
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "It spends almost the whole year underground, digging head first.",
      "tags": [
        "burrower"
      ],
      "source": "literature",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4814056"
    },
    {
      "category": "reproduction",
      "text": "It comes above ground for just a few hours a year, when the monsoon rains start, to breed.",
      "tags": [
        "surfaces_to_breed"
      ],
      "source": "iucn"
    },
    {
      "category": "reproduction",
      "text": "Its tadpoles hold on to rocks in rushing streams with a sucker mouth.",
      "tags": [
        "sucker_mouth_tadpoles"
      ],
      "source": "literature"
    },
    {
      "category": "conservation",
      "text": "Main threats: granite quarries, new roads, landslides, and farms clearing its forest.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Scientists call it the 'coelacanth of frogs'. Its closest living relatives live far away, on the islands of the Seychelles.",
      "source": "literature",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC4814056"
    },
    {
      "category": "key_fact",
      "text": "Scientists only described it in 2003, even though its tadpoles were first found in 1917.",
      "source": "wikipedia"
    },
    {
      "category": "life_description",
      "text": "Eggs are laid in small rocky pools in fast streams. The tadpoles grow for about 100 days.",
      "source": "literature"
    },
    {
      "category": "behavior",
      "text": "Its call is said to sound like a clucking chicken.",
      "source": "wikipedia"
    }
  ],
