{
  "id": 17,
  "commonName": "Pig-nosed Turtle",
  "scientificName": "Carettochelys insculpta",
  "taxonomy": {
    "class": "Reptilia",
    "order": "Testudines",
    "family": "Carettochelyidae",
    "genus": "Carettochelys"
  },
