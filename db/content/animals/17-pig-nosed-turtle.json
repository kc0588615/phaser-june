  ],
  "traits": {
    "covering": {
      "value": "shell",
      "note": "Its shell is covered in leathery skin instead of hard plates.",
      "source": "adw"
    },
    "diet": {
      "value": "mixed",
      "note": "Mostly fruit, leaves and flowers from the riverbank, plus snails and insects.",
      "source": "adw"
    },
    "social": {
      "value": "groups",
      "note": "In the dry season, many gather together in the river pools that are left.",
      "source": "adw"
    },
    "trees": {
      "value": "no",
      "note": "It stays down low and never climbs up into trees.",
      "source": "adw"
    },
    "birth": {
      "value": "eggs",
      "source": "adw"
    },
    "lifespan": {
      "value": "long",
      "note": "One lived more than 38 years in a zoo.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "Its nose looks like a pig's snout.",
      "tags": [
        "pig_nose"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its front legs are paddle-shaped flippers, like a sea turtle's.",
      "tags": [
        "flippers"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It uses its nose as a snorkel to breathe in murky water.",
      "tags": [
        "snorkel_nose"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Males never leave the water, and females come out only to lay eggs.",
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in rivers, lagoons and even salty water near the coast.",
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Whether its eggs hatch as males or females depends on nest temperature: half a degree makes the difference.",
      "tags": [
        "temperature_sex"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Main threats: turtles and eggs collected for food and the pet trade, and pollution from mines.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its colors or pattern help it blend in with its surroundings, so it is hard to see.",
      "tags": [
        "camouflage"
      ],
      "source": "smithsonian",
      "url": "https://nationalzoo.si.edu/animals/fly-river-turtle"
    },
    {
      "category": "morphology",
      "text": "Its face has bold markings in a contrasting color, such as patches, rings or lines.",
      "tags": [
        "face_markings"
      ],
      "source": "tftsg",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Accounts/crm_5_009_insculpta_v1_2008.pdf"
    },
    {
      "category": "morphology",
      "text": "It bites or chews with unusual force for its size.",
      "tags": [
        "strong_bite"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "As an adult, it has no teeth at all.",
      "tags": [
        "toothless"
      ],
      "source": "britannica",
      "url": "https://www.britannica.com/animal/turtle-reptile"
    },
    {
      "category": "morphology",
      "text": "It can take in oxygen from the water while it stays underwater.",
      "tags": [
        "underwater_breathing"
      ],
      "source": "literature",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6298445/"
    },
    {
      "category": "morphology",
      "text": "It has webbed feet: skin joins its toes.",
      "tags": [
        "webbed_feet"
      ],
      "source": "tftsg",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Accounts/crm_5_009_insculpta_v1_2008.pdf"
    },
    {
      "category": "diet",
      "text": "Fruit is a main or favorite part of its food.",
      "tags": [
        "fruit_eater"
      ],
      "source": "iucn"
    },
    {
      "category": "diet",
      "text": "Leaves are a main part of its food.",
      "tags": [
        "leaf_eater"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It never climbs trees: it stays on or under the ground, or in water.",
      "tags": [
        "never_climbs"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It rests on the bottom of a river, lake or pond, under water.",
      "tags": [
        "rests_on_bottom"
      ],
      "source": "literature",
      "url": "https://chelonian.org/wp-content/uploads/file/CCB_Vol_4_Nos1-4(2001-2005)/Doody_etal_2001.pdf"
    },
    {
      "category": "behavior",
      "text": "It swims well or often.",
      "tags": [
        "swimmer"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in large rivers, not only in small streams or ponds.",
      "tags": [
        "big_rivers"
      ],
      "source": "literature",
      "url": "https://chelonian.org/wp-content/uploads/file/CCB_Vol_4_Nos1-4(2001-2005)/Doody_etal_2001.pdf"
    },
    {
      "category": "habitat",
      "text": "It lives in rivers or lakes with soft, sandy or muddy bottoms.",
      "tags": [
        "sandy_bottoms"
      ],
      "source": "tftsg",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Accounts/crm_5_009_insculpta_v1_2008.pdf"
    },
    {
      "category": "habitat",
      "text": "It lives or breeds in shallow, still water, such as marshes, ponds, pools or bogs.",
      "tags": [
        "shallow_wetlands"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly in brackish water, part salty and part fresh, as in estuaries, coastal lagoons or mangroves.",
      "tags": [
        "brackish_water"
      ],
      "source": "adw"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its nose has special sensors that help it find food in muddy water.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "Females travel together to find safe beaches for their eggs.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "In Australia's Daly River, females nest every other year, laying two clutches in the dry season.",
      "source": "adw"
    }
  ],
