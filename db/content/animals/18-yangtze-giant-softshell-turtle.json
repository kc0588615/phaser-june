  "facts": [
    {
      "category": "key_fact",
      "text": "A giant turtle lived for decades in Hoan Kiem Lake in the middle of Hanoi, Vietnam, until it died in 2016.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "Scientists think one generation of this turtle lasts about 100 years.",
      "source": "iucn"
    },
    {
      "category": "threat",
      "text": "Dams, sand mining and polluted rivers destroyed much of its home.",
      "source": "iucn"
    }
  ],
