  "clues": [
    {
      "category": "morphology",
      "text": "It was a giant tortoise.",
      "tags": [
        "giant_tortoise"
      ],
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its shell was a 'saddleback': raised at the front like a saddle.",
      "tags": [
        "saddleback_shell"
      ],
      "source": "ngo"
    },
    {
      "category": "habitat",
      "text": "It lived on Floreana Island in the Galápagos.",
      "tags": [
        "floreana_island"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "By eating fruit and spreading the seeds, it helped shape the island's forests.",
      "source": "ngo"
    },
    {
      "category": "conservation",
      "text": "It died out in the mid-1800s, hunted by whalers and harmed by animals people brought to the island.",
      "source": "ngo"
    },
    {
      "category": "conservation",
      "text": "In February 2026, 158 young tortoises with Floreana ancestry were released on the island.",
      "source": "ngo"
    },
    {
      "category": "morphology",
      "text": "It had five claws on each front foot.",
      "tags": [
        "five_front_claws"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Gal%C3%A1pagos_tortoise"
    },
    {
      "category": "morphology",
      "text": "As an adult, it had no teeth at all.",
      "tags": [
        "toothless"
      ],
      "source": "sdzwa",
      "url": "https://animals.sandiegozoo.org/animals/galapagos-giant-tortoise"
    },
    {
      "category": "behavior",
      "text": "It often rested in the sun to warm its body.",
      "tags": [
        "basker"
      ],
      "source": "sdzwa",
      "url": "https://animals.sandiegozoo.org/animals/galapagos-giant-tortoise"
    },
    {
      "category": "diet",
      "text": "It found most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "literature",
      "url": "https://www.reptilesofecuador.com/chelonoidis_niger.html"
    },
    {
      "category": "behavior",
      "text": "It lived and fed on the forest floor, and rarely if ever climbed up into the trees.",
      "tags": [
        "forest_floor"
      ],
      "source": "literature",
      "url": "https://www.reptilesofecuador.com/chelonoidis_niger.html"
    },
    {
      "category": "behavior",
      "text": "It made a loud hissing sound.",
      "tags": [
        "hisses"
      ],
      "source": "literature",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Articles/Van_Denburgh_1914.pdf"
    },
    {
      "category": "behavior",
      "text": "It made loud calls that carried far, such as roars or bellows.",
      "tags": [
        "loud_calls"
      ],
      "source": "literature",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Articles/Van_Denburgh_1914.pdf"
    },
    {
      "category": "diet",
      "text": "It could go days or longer without drinking, getting most of its water from its food.",
      "tags": [
        "rarely_drinks"
      ],
      "source": "literature",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Articles/Van_Denburgh_1914.pdf"
    },
    {
      "category": "behavior",
      "text": "It moved very slowly, even when disturbed.",
      "tags": [
        "slow_mover"
      ],
      "source": "literature",
      "url": "https://iucn-tftsg.org/wp-content/uploads/file/Articles/Van_Denburgh_1914.pdf"
    },
    {
      "category": "diet",
      "text": "It spread plant seeds to new places by eating them, often in fruit, and passing them in its droppings.",
      "tags": [
        "seed_spreader"
      ],
      "source": "ngo"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It was the first Galápagos tortoise species to be driven extinct.",
      "source": "ngo"
    },
    {
      "category": "key_fact",
      "text": "Whalers moved tortoises between islands as food. Some Floreana tortoises survived on Wolf Volcano, and their hybrid descendants are now being bred to bring the lineage back.",
      "source": "ngo"
    },
    {
      "category": "key_fact",
      "text": "One of the last sightings of Floreana tortoises was around the time of Charles Darwin's visit.",
      "source": "ngo"
    }
  ],
