  "clues": [
    {
      "category": "morphology",
      "text": "It was a giant tortoise.",
      "tags": [
        "giant_tortoise"
      ],
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its shell was a 'saddleback': raised at the front like a saddle.",
      "tags": [
        "saddleback_shell"
      ],
      "source": "ngo"
    },
    {
      "category": "habitat",
      "text": "It lived on Floreana Island in the Galápagos.",
      "tags": [
        "floreana_island"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "By eating fruit and spreading the seeds, it helped shape the island's forests.",
      "tags": [
        "seed_spreader"
      ],
      "source": "ngo"
    },
    {
      "category": "conservation",
      "text": "It died out in the mid-1800s, hunted by whalers and harmed by animals people brought to the island.",
      "source": "ngo"
    },
    {
      "category": "conservation",
      "text": "In February 2026, 158 young tortoises with Floreana ancestry were released on the island.",
      "source": "ngo"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It was the first Galápagos tortoise species to be driven extinct.",
      "source": "ngo"
    },
    {
      "category": "key_fact",
      "text": "Whalers moved tortoises between islands as food. Some Floreana tortoises survived on Wolf Volcano, and their hybrid descendants are now being bred to bring the lineage back.",
      "source": "ngo"
    },
    {
      "category": "key_fact",
      "text": "One of the last sightings of Floreana tortoises was around the time of Charles Darwin's visit.",
      "source": "ngo"
    }
  ],
