  "clues": [
    {
      "category": "morphology",
      "text": "It is the biggest tortoise living on a continent instead of an island.",
      "tags": [
        "giant_tortoise"
      ],
      "source": "tftsg"
    },
    {
      "category": "morphology",
      "text": "It has big pointed scales, like spurs, on its back legs.",
      "tags": [
        "leg_spurs"
      ],
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "It digs deep burrows, up to 15 m long, to escape the heat.",
      "tags": [
        "burrower"
      ],
      "source": "tftsg"
    },
    {
      "category": "behavior",
      "text": "Males fight by ramming each other, and the bigger male usually wins.",
      "tags": [
        "territorial"
      ],
      "source": "tftsg"
    },
    {
      "category": "habitat",
      "text": "It lives in dry savanna, often along streams that only flow in the rainy season.",
      "tags": [
        "seasonal_streams"
      ],
      "source": "tftsg"
    },
    {
      "category": "conservation",
      "text": "Main threats: farms and cattle taking over its land, and people collecting it for food and the pet trade.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the largest tortoise in Africa.",
      "source": "tftsg"
    },
    {
      "category": "key_fact",
      "text": "It breeds easily in captivity, and many local communities raise them.",
      "source": "tftsg"
    }
  ],
