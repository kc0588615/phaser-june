  "clues": [
    {
      "category": "morphology",
      "text": "Its dark shell is covered in yellow lines that spread out like stars.",
      "tags": [
        "star_pattern"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its head, legs and feet are yellow, with a black patch on top of the head.",
      "tags": [
        "yellow_head"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It grazes the same patches again and again, keeping the plants trimmed short like a lawn mower.",
      "tags": [
        "grazer"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in the dry spiny forests and brush of southern Madagascar.",
      "tags": [
        "spiny_forest"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Main threats: collecting for food and the pet trade, and loss of its forest.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "A radiated tortoise named Tu'i Malila, given to the royal family of Tonga, is said to have lived about 188 years.",
      "source": "wikipedia"
    },
    {
      "category": "life_description",
      "text": "Its eggs take 145 to 231 days to hatch.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Hatchlings are white to off-white, not yellow like the adults.",
      "source": "adw"
