  "traits": {
    "covering": {
      "value": "fur",
      "note": "Its long, coarse coat is dark brown or black, with scattered white hairs.",
      "source": "adw"
    },
    "size": {
      "value": "medium",
      "note": "It weighs about 2.5 kg.",
      "source": "adw"
    },
    "diet": {
      "value": "mixed",
      "note": "It eats beetle grubs, nuts, seeds, fruit and nectar.",
      "source": "adw"
    },
    "activity": {
      "value": "night",
      "note": "It wakes up around sunset.",
      "source": "adw"
    },
    "social": {
      "value": "alone",
      "note": "Now and then two or three forage together.",
      "source": "iucn"
    },
    "trees": {
      "value": "yes",
      "note": "It spends most of its time high in the treetops.",
      "source": "adw"
    },
    "birth": {
      "value": "live",
      "source": "adw"
    },
    "young": {
      "value": "one",
      "note": "A mother has one baby every 2 or 3 years.",
      "source": "adw"
    },
    "lifespan": {
      "value": "long",
      "note": "One aye-aye lived more than 23 years in a zoo.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "Its front teeth never stop growing, like a rodent's.",
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has big eyes and large, bat-like ears.",
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its bushy tail is longer than its body.",
      "source": "ngo",
      "url": "https://www.worldwildlife.org/news/magazine/spring-2021/meet-the-aye-aye-the-worlds-weirdest-primate"
    },
    {
      "category": "morphology",
      "text": "One finger on each hand is extra long and as thin as a twig.",
      "tags": [
        "long_finger"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has a tiny extra 'false thumb' that helps it grip branches.",
      "tags": [
        "false_thumb"
      ],
      "source": "literature",
      "url": "https://doi.org/10.1002/ajpa.23936"
    },
    {
      "category": "behavior",
      "text": "It sleeps all day in a ball-shaped nest of leaves high in the trees.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It often hangs upside down from branches.",
      "tags": [
        "hangs_upside_down"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It taps on bark with its thin finger and listens for hollow tunnels where grubs hide.",
      "tags": [
        "tap_forager"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It also drinks nectar from the flowers of the traveler's tree.",
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It gnaws a hole through bark or a nutshell, then scoops out the food with its thin finger.",
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "In some places people believe it brings bad luck, so it gets hunted.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Trees it feeds from are cut down to build boats and houses.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its fur is black or nearly black all over, at least in some individuals.",
      "tags": [
        "black_coat"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its colors or pattern help it blend in with its surroundings, so it is hard to see.",
      "tags": [
        "camouflage"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its face has bold markings in a contrasting color, such as patches, rings or lines.",
      "tags": [
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has five claws on each front foot.",
      "tags": [
        "five_front_claws"
      ],
      "source": "literature",
      "url": "https://www.science.smith.edu/departments/Biology/VHAYSSEN/msi/pdf/740_Daubentonia_madagascariensis.pdf"
    },
    {
      "category": "morphology",
      "text": "It bites or chews with unusual force for its size.",
      "tags": [
        "strong_bite"
      ],
      "source": "literature",
      "url": "https://pubmed.ncbi.nlm.nih.gov/24339191/"
    },
    {
      "category": "morphology",
      "text": "It has very sharp hearing and relies on it.",
      "tags": [
        "super_hearing"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has a patch of contrasting color on its throat.",
      "tags": [
        "throat_patch"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Some of its teeth keep growing all its life.",
      "tags": [
        "ever_growing_teeth"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its eyes are large for its head.",
      "tags": [
        "large_eyes"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its ears are large for its head.",
      "tags": [
        "big_ears"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its tail is long: at least two-thirds as long as its head and body.",
      "tags": [
        "long_tail"
      ],
      "source": "ngo",
      "url": "https://www.worldwildlife.org/news/magazine/spring-2021/meet-the-aye-aye-the-worlds-weirdest-primate"
    },
    {
      "category": "behavior",
      "text": "It climbs well or often, in trees, on rocks or both.",
      "tags": [
        "climber"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Fruit is a main or favorite part of its food.",
      "tags": [
        "fruit_eater"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It rests by hanging or perching in tree branches.",
      "tags": [
        "roosts_in_trees"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes loud, harsh screeches.",
      "tags": [
        "screecher"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "At least sometimes, it stands, rears up, hops or runs on its back legs alone.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/ayeaye/behavior"
    },
    {
      "category": "diet",
      "text": "It drinks nectar from flowers.",
      "tags": [
        "nectar_drinker"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It builds a nest or bed of leaves, branches or grass to sleep or rest in.",
      "tags": [
        "sleeping_nests"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It sleeps or rests high up in trees.",
      "tags": [
        "sleeps_high_in_trees"
      ],
      "source": "adw"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It does the job of a woodpecker in Madagascar, which has no woodpeckers: it taps on wood to find grubs inside.",
      "source": "news",
      "url": "https://www.eurekalert.org/news-releases/598865"
    },
    {
      "category": "key_fact",
      "text": "In 2019 scientists found it has a tiny sixth finger, a 'pseudothumb' with its own fingerprint, that helps it grip branches.",
      "source": "literature",
      "url": "https://doi.org/10.1002/ajpa.23936"
    },
    {
      "category": "key_fact",
      "text": "Its rodent-like teeth and bushy tail made early scientists think it was a kind of squirrel. It is really a lemur, a primate like us.",
      "source": "news",
      "url": "https://kids.nationalgeographic.com/animals/mammals/facts/aye-aye"
    },
    {
      "category": "behavior",
      "text": "When it is scared or excited, it fluffs up its long hairs and looks twice as big.",
      "source": "ngo",
      "url": "https://www.worldwildlife.org/news/magazine/spring-2021/meet-the-aye-aye-the-worlds-weirdest-primate"
    },
    {
      "category": "life_description",
      "text": "Babies have green eyes and floppy ears. They first leave the nest at about 8 weeks old.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Young aye-ayes still beg their mothers for food at a year old.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Its numbers are thought to have fallen by half or more in 36 years, from forest loss and hunting.",
      "source": "iucn"
    }
  ],
  "sources": {
