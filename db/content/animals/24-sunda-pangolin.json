  "clues": [
    {
      "category": "morphology",
      "text": "It has no teeth at all.",
      "tags": [
        "toothless"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its sticky tongue can stretch about 25 cm out of its mouth.",
      "tags": [
        "long_tongue"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its long tail can grip branches, and it uses it to climb trees.",
      "tags": [
        "long_tail",
        "climber"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "When it is scared, it curls up into a tight ball.",
      "tags": [
        "rolls_into_ball"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It digs burrows near termite mounds and ant nests with its big front claws.",
      "tags": [
        "burrower",
        "digging_claws"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "When it hurries, it runs on just its back legs, balancing with its tail.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It has poor eyesight but a great sense of smell.",
      "tags": [
        "poor_eyesight"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Sunda_pangolin"
    },
    {
      "category": "reproduction",
      "text": "A baby rides around on the base of its mother's tail.",
      "tags": [
        "mother_carries_young"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It can close its nostrils and ears so ants can't crawl in while it eats.",
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Pangolins are among the most illegally traded mammals on Earth, taken for their scales and meat.",
      "source": "news",
      "url": "https://www.nationalgeographic.com/animals/mammals/facts/sunda-pangolin"
    },
    {
      "category": "conservation",
      "text": "It is protected from all international trade under CITES.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Pangolins are the only mammals covered in scales.",
      "source": "news",
      "url": "https://www.nationalgeographic.com/animals/mammals/facts/sunda-pangolin"
    },
    {
      "category": "key_fact",
      "text": "Its tongue is so long that, when pulled in, it reaches down through its chest to near its hips.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "Its scales are made of keratin, the same stuff as your fingernails.",
      "source": "news",
      "url": "https://www.nationalgeographic.com/animals/mammals/facts/sunda-pangolin"
    },
    {
      "category": "behavior",
      "text": "A mother in danger curls into a ball with her baby tucked safely inside.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Babies are born with soft scales that harden after a few days.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Hunting and poaching are thought to have cut its numbers by 80% in just 21 years.",
      "source": "iucn"
    }
  ],
