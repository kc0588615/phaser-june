  "traits": {
    "covering": {
      "value": "fur",
      "note": "Its fur is reddish orange with black stripes and a white belly.",
      "source": "smithsonian"
    },
    "size": {
      "value": "large",
      "note": "The biggest males weigh up to about 300 kg.",
      "source": "smithsonian"
    },
    "diet": {
      "value": "meat",
      "note": "It mostly hunts deer and wild pigs.",
      "source": "iucn"
    },
    "activity": {
      "value": "night",
      "note": "It hunts mostly at night, but can be active any time.",
      "source": "adw"
    },
    "social": {
      "value": "alone",
      "note": "The only lasting bond is between a mother and her cubs.",
      "source": "adw"
    },
    "trees": {
      "value": "no",
      "note": "It rests and moves on the ground; no source puts it up in trees.",
      "source": "smithsonian"
    },
    "birth": {
      "value": "live",
      "source": "adw"
    },
    "young": {
      "value": "few",
      "note": "A mother has 1 to 7 cubs at a time.",
      "source": "adw"
    },
    "lifespan": {
      "value": "long",
      "note": "Wild tigers usually live 10 to 15 years, and some reach their 20s.",
      "source": "smithsonian"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "It has stripes, and no two have the same pattern, like fingerprints.",
      "source": "smithsonian"
    },
    {
      "category": "morphology",
      "text": "It has a white spot on the back of each ear.",
      "source": "smithsonian"
    },
    {
      "category": "behavior",
      "text": "It is a strong swimmer and easily crosses rivers.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Each one marks its own home area with scent and scratches.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It can leap 8 to 10 m in one bound.",
      "tags": [
        "big_leaper"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It sneaks up close, using every bush and rock as cover, then pounces.",
      "tags": [
        "ambush_hunter"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It likes prey about as heavy as itself, like big deer.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "The 2022 Red List count found about 3,140 adult tigers in the wild.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Poaching for its skin and bones, and the loss of its prey, are the main threats.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its fur is black or nearly black all over, at least in some individuals.",
      "tags": [
        "black_coat"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tiger"
    },
    {
      "category": "morphology",
      "text": "Its colors or pattern help it blend in with its surroundings, so it is hard to see.",
      "tags": [
        "camouflage"
      ],
      "source": "smithsonian"
    },
    {
      "category": "morphology",
      "text": "Its face has bold markings in a contrasting color, such as patches, rings or lines.",
      "tags": [
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has five claws on each front foot.",
      "tags": [
        "five_front_claws"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/tiger/characteristics"
    },
    {
      "category": "morphology",
      "text": "Its fur is mostly red, reddish brown or golden red.",
      "tags": [
        "reddish_fur"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its tail has rings of alternating colors.",
      "tags": [
        "ringed_tail"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It bites or chews with unusual force for its size.",
      "tags": [
        "strong_bite"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has a patch of contrasting color on its throat.",
      "tags": [
        "throat_patch"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has webbed feet: skin joins its toes.",
      "tags": [
        "webbed_feet"
      ],
      "source": "sdzwa",
      "url": "https://animals.sandiegozoo.org/animals/tiger"
    },
    {
      "category": "morphology",
      "text": "It has one or more stripes: long bands of a contrasting color on its body or legs.",
      "tags": [
        "stripes"
      ],
      "source": "smithsonian"
    },
    {
      "category": "morphology",
      "text": "The back of each ear has a bold spot of a contrasting color.",
      "tags": [
        "ear_spots"
      ],
      "source": "smithsonian"
    },
    {
      "category": "behavior",
      "text": "It climbs well or often, in trees, on rocks or both.",
      "tags": [
        "climber"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It can run fast, at about 50 km/h or more.",
      "tags": [
        "fast_runner"
      ],
      "source": "ngo",
      "url": "https://wwf.ca/stories/19-amazing-tiger-facts-global-tiger-day"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes a loud hissing sound.",
      "tags": [
        "hisses"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes loud calls that carry far, such as songs, hoots, barks, roars or wails.",
      "tags": [
        "loud_calls"
      ],
      "source": "ngo",
      "url": "https://wwf.ca/stories/19-amazing-tiger-facts-global-tiger-day"
    },
    {
      "category": "behavior",
      "text": "It calls with deep, low rumbles, some too low for people to hear.",
      "tags": [
        "low_rumbles"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/tiger/behavior"
    },
    {
      "category": "behavior",
      "text": "At least sometimes, it stands, rears up, hops or runs on its back legs alone.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/tiger/behavior"
    },
    {
      "category": "diet",
      "text": "It gathers food and stores it to eat later.",
      "tags": [
        "stores_food"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It swims well or often.",
      "tags": [
        "swimmer"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It defends an area, such as a territory, home patch or den site, against others of its kind.",
      "tags": [
        "territorial"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly in the open zone high on mountains above the tree line, where it is too cold for trees to grow.",
      "tags": [
        "above_tree_line"
      ],
      "source": "government",
      "url": "https://www.wwf.de/fileadmin/fm-wwf/Publikationen-PDF/Asien/Bhutan-National-Tiger-Survey-Report.pdf"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly in brackish water, part salty and part fresh, as in estuaries, coastal lagoons or mangroves.",
      "tags": [
        "brackish_water"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly where snow covers the ground for weeks or months in winter.",
      "tags": [
        "snowy_winters"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly in dry, thorny forest or brush.",
      "tags": [
        "spiny_forest"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "In some places it lives in or near human settlements, such as towns, villages, gardens, parks or plantations.",
      "tags": [
        "town_dweller"
      ],
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the biggest cat species in the world.",
      "source": "smithsonian"
    },
    {
      "category": "key_fact",
      "text": "Its stripes are on its skin, not just its fur.",
      "source": "ngo",
      "url": "https://wwf.ca/stories/19-amazing-tiger-facts-global-tiger-day"
    },
    {
      "category": "key_fact",
      "text": "Only about 1 hunt in 10 to 20 succeeds.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "Tigers live in places as different as snowy forests in Russia and mangrove swamps by the sea.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "Tigers can't purr, but they roar, grunt and make a friendly puffing sound called chuffing.",
      "source": "smithsonian",
      "url": "https://nationalzoo.si.edu/animals/news/just-how-big-are-tigers-what-does-tiger-poop-look-and-more-tiger-facts"
    },
    {
      "category": "life_description",
      "text": "Cubs are born blind and helpless. They stay with their mother until they are 18 months to 3 years old.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Tigers have vanished from large areas of good forest because of poaching and too little prey.",
      "source": "iucn"
    }
  ],
