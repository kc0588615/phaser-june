  "traits": {
    "covering": {
      "value": "skin",
      "note": "Its wrinkled gray skin has only a few scattered hairs.",
      "source": "adw"
    },
    "size": {
      "value": "huge",
      "note": "Males weigh 3,500 to 6,000 kg.",
      "source": "adw"
    },
    "diet": {
      "value": "plants",
      "note": "It eats grass, leaves, bark, roots and fruit: more than 100 kinds of plants.",
      "source": "adw"
    },
    "activity": {
      "value": "any",
      "note": "It spends 12 to 18 hours a day finding and eating food.",
      "source": "adw"
    },
    "social": {
      "value": "groups",
      "note": "Related females and their young live in herds. Adult males live alone or in small groups.",
      "source": "adw"
    },
    "trees": {
      "value": "no",
      "note": "It lives on the ground and keeps on the move.",
      "source": "adw"
    },
    "birth": {
      "value": "live",
      "source": "adw"
    },
    "young": {
      "value": "one",
      "note": "Twins are very rare.",
      "source": "adw"
    },
    "lifespan": {
      "value": "long",
      "note": "It can live 60 to 70 years.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "It has a long trunk with one finger-like tip.",
      "tags": [
        "trunk"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Only males grow tusks, and in Sri Lanka most males have none.",
      "tags": [
        "tusks"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It flaps its big ears to cool off.",
      "tags": [
        "big_ears"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It is a good swimmer and can use its trunk as a snorkel.",
      "tags": [
        "trunk"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It coats itself in mud and dust to keep its skin cool.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It can call with rumbles too low for people to hear.",
      "tags": [
        "low_rumbles"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It eats about a tenth of its own weight in food every day.",
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Fewer than 50,000 are left in the wild.",
      "source": "smithsonian",
      "url": "https://nationalzoo.si.edu/news/asian-elephant-pregnant-smithsonians-national-zoo-and-conservation-biology-institute"
    },
    {
      "category": "conservation",
      "text": "Its forests are being cut into pieces too small for herds to live in.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Some of its teeth keep growing all its life.",
      "tags": [
        "ever_growing_teeth"
      ],
      "source": "smithsonian",
      "url": "https://www.nationalzoo.si.edu/animals/asian-elephant"
    },
    {
      "category": "morphology",
      "text": "It has very sharp hearing and relies on it.",
      "tags": [
        "super_hearing"
      ],
      "source": "smithsonian",
      "url": "https://www.nationalzoo.si.edu/animals/asian-elephant"
    },
    {
      "category": "behavior",
      "text": "It makes short, high, bird-like chirping calls.",
      "tags": [
        "chirps"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Asian_elephant"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It lives and feeds on the forest floor, and rarely if ever climbs up into the trees.",
      "tags": [
        "forest_floor"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It mostly eats grass or other low plants that it crops from the ground.",
      "tags": [
        "grazer"
      ],
      "source": "iucn"
    },
    {
      "category": "diet",
      "text": "Leaves are a main part of its food.",
      "tags": [
        "leaf_eater"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes loud calls that carry far, such as songs, hoots, barks, roars or wails.",
      "tags": [
        "loud_calls"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Asian_elephant"
    },
    {
      "category": "behavior",
      "text": "It never climbs trees: it stays on or under the ground, or in water.",
      "tags": [
        "never_climbs"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It sees poorly or not at all, and relies mainly on smell, hearing or touch.",
      "tags": [
        "poor_eyesight"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It pushes or knocks over whole trees to feed.",
      "tags": [
        "pushes_over_trees"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It visits salt licks, or eats mineral-rich soil, clay or water, to get minerals.",
      "tags": [
        "salt_licks"
      ],
      "source": "smithsonian",
      "url": "https://www.nationalzoo.si.edu/animals/asian-elephant"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It spreads plant seeds to new places by eating them, often in fruit, and passing them in its droppings.",
      "tags": [
        "seed_spreader"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It can feel vibrations or ripples through the ground or water, to sense prey, danger or others.",
      "tags": [
        "senses_vibrations"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It can breathe through the tip of its raised nose, snout or trunk while the rest of its body stays under water.",
      "tags": [
        "snorkel_nose"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes high squeaking calls.",
      "tags": [
        "squeaker"
      ],
      "source": "smithsonian",
      "url": "https://www.nationalzoo.si.edu/animals/asian-elephant"
    },
    {
      "category": "behavior",
      "text": "At least sometimes, it stands, rears up, hops or runs on its back legs alone.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "ngo",
      "url": "https://elephantconservation.org/wp-content/uploads/2022/05/CompleteHusbandryGuide1stEdition.pdf"
    },
    {
      "category": "behavior",
      "text": "It swims well or often.",
      "tags": [
        "swimmer"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It uses objects such as sticks or stones as tools to get food or do tasks.",
      "tags": [
        "uses_tools"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It wallows in mud, or coats itself with mud, to cool off or protect its skin.",
      "tags": [
        "mud_bather"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly high up in mountains: on upper slopes, high plateaus or alpine zones, not just foothills.",
      "tags": [
        "high_mountains"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly in dry, thorny forest or brush.",
      "tags": [
        "spiny_forest"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "In some places it lives in or near human settlements, such as towns, villages, gardens, parks or plantations.",
      "tags": [
        "town_dweller"
      ],
      "source": "literature",
      "url": "https://journals.sagepub.com/doi/10.1177/194008291000300203"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the largest land animal in Asia.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Asian_elephant"
    },
    {
      "category": "key_fact",
      "text": "A mother carries her calf for 18 to 22 months, nearly two years.",
      "source": "smithsonian",
      "url": "https://nationalzoo.si.edu/news/asian-elephant-pregnant-smithsonians-national-zoo-and-conservation-biology-institute"
    },
    {
      "category": "key_fact",
      "text": "You can tell it from an African elephant: its ears are smaller, and its head, not its shoulders, is the highest point of its body.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "The tip of its trunk is so sensitive it can feel vibrations in the ground.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "A newborn calf weighs about 100 kg.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "More than 69% of the Sumatran elephant's forest was lost in just 25 years.",
      "source": "iucn"
    }
  ],
