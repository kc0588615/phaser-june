  "clues": [
    {
      "category": "morphology",
      "text": "Its velvety body is dark reddish brown.",
      "tags": [
        "reddish_fur"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its legs have white and brown stripes, like a zebra's.",
      "tags": [
        "stripes"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its long, dark tongue can reach more than 30 cm.",
      "tags": [
        "long_tongue"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Males have two short horns covered in skin.",
      "tags": [
        "horns"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It walks on hooves.",
      "tags": [
        "hooves"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It licks clay, charcoal and even bat droppings to get extra minerals.",
      "tags": [
        "salt_licks"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It marks its home area with urine and by rubbing its neck to leave its scent.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It only lives under the tall, closed canopy of the rainforest, never in open country.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Logging and people settling in its forests, even in protected areas, are its main threats.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It looks like part zebra, but its closest living relative is the giraffe.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "People of the Ituri Forest knew it for generations, but scientists only learned about it in 1901.",
      "source": "sdzwa",
      "url": "https://animals.sandiegozoo.org/animals/okapi"
    },
    {
      "category": "key_fact",
      "text": "It is the only forest hoofed animal that lives mainly on leaves from the forest's lower layer.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It drinks like a giraffe, with its front legs spread wide and knees bent.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "A mother hides her newborn in a quiet spot and comes back to feed it, so predators can't find it.",
      "source": "sdzwa",
      "url": "https://animals.sandiegozoo.org/animals/okapi"
    },
    {
      "category": "threat",
      "text": "Surveys in the Okapi Wildlife Reserve found a 43% drop in numbers from 1995 to 2007.",
      "source": "iucn"
    }
  ],
