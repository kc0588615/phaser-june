  "clues": [
    {
      "category": "morphology",
      "text": "Green algae grow in its fur and help it blend in with the leaves.",
      "tags": [
        "camouflage",
        "algae_fur"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It moves very slowly and spends most of its life up in the trees.",
      "tags": [
        "slow_mover"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Like other tree sloths, it hangs upside down from branches.",
      "tags": [
        "hangs_upside_down"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Sloth"
    },
    {
      "category": "behavior",
      "text": "It is slow in the trees, but it can swim.",
      "tags": [
        "slow_mover"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives only on Isla Escudo de Veraguas, a tiny island off the coast of Panama.",
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives in red mangroves along the shore and in the island's rainforest.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Only about 2,000 to 2,500 live on its island.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "New buildings, visitors and tree cutting on its island put it at risk.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its throat is brown, standing out from the color around it.",
      "tags": [
        "brown_throat"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Some of its teeth keep growing all its life.",
      "tags": [
        "ever_growing_teeth"
      ],
      "source": "adw",
      "url": "https://animaldiversity.org/accounts/Bradypodidae/"
    },
    {
      "category": "morphology",
      "text": "A dark band or patch across its eyes looks like a mask.",
      "tags": [
        "face_mask"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its arms are very long, longer than its legs.",
      "tags": [
        "long_arms"
      ],
      "source": "adw",
      "url": "https://animaldiversity.org/accounts/Bradypodidae/"
    },
    {
      "category": "morphology",
      "text": "Its tail is very short, just a stub.",
      "tags": [
        "stubby_tail"
      ],
      "source": "adw",
      "url": "https://animaldiversity.org/accounts/Bradypodidae/"
    },
    {
      "category": "behavior",
      "text": "It often rests in the sun to warm its body.",
      "tags": [
        "basker"
      ],
      "source": "literature",
      "url": "https://treatment.plazi.org/GgServer/xhtml/FFF8FF9B2B17FFC26666FF81FF96BE7C"
    },
    {
      "category": "behavior",
      "text": "It climbs well or often, in trees, on rocks or both.",
      "tags": [
        "climber"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Leaves are a main part of its food.",
      "tags": [
        "leaf_eater"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It sees poorly or not at all, and relies mainly on smell, hearing or touch.",
      "tags": [
        "poor_eyesight"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It rests by hanging or perching in tree branches.",
      "tags": [
        "roosts_in_trees"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Sloth"
    },
    {
      "category": "behavior",
      "text": "It lives in trees and seldom comes down to the ground.",
      "tags": [
        "seldom_on_ground"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It sleeps or rests high up in trees.",
      "tags": [
        "sleeps_high_in_trees"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Pygmy_three-toed_sloth"
    },
    {
      "category": "behavior",
      "text": "It swims well or often.",
      "tags": [
        "swimmer"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "A mother carries her eggs or young on her body as she moves about.",
      "tags": [
        "mother_carries_young"
      ],
      "source": "ngo",
      "url": "https://www.edgeofexistence.org/species/pygmy-three-toed-sloth/"
    },
    {
      "category": "geography",
      "text": "Its entire natural wild range is, or was, on a single island.",
      "tags": [
        "one_island"
      ],
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the smallest sloth in the world.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "Its island was cut off from the mainland by rising seas thousands of years ago, and the sloths there slowly became smaller than their mainland cousins.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Pygmy_three-toed_sloth"
    },
    {
      "category": "key_fact",
      "text": "Scientists only named it as its own species in 2001.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "The algae in a sloth's fur make it a tiny home for moths and beetles, too.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Sloth"
    },
    {
      "category": "threat",
      "text": "It is Critically Endangered mainly because its whole world is one island smaller than 5 square km.",
      "source": "iucn"
    }
  ],
