    },
    "activity": {
      "value": "day",
      "note": "At night it sleeps out in the open.",
      "source": "adw"
    },
    "social": {
      "value": "groups",
      "note": "Packs have 3 to 13 wolves.",
      "source": "adw"
    },
    "trees": {
      "value": "no",
      "note": "It moves about on the ground.",
      "source": "iucn"
    },
    "birth": {
      "value": "live",
      "source": "adw"
    },
    "young": {
      "value": "few",
      "note": "A litter has 2 to 6 pups.",
      "source": "adw"
    },
    "lifespan": {
      "value": "medium",
      "note": "Wild wolves live up to about 12 years.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "It has a red coat with a white throat and a white crescent under each eye.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It lives in a pack, but each wolf hunts on its own.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Packs patrol their borders and mark them with scent.",
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It hunts rodents, especially the big giant mole-rat.",
      "source": "iucn"
    },
    {
      "category": "diet",
      "text": "It licks sweet nectar from red hot poker flowers.",
      "source": "literature",
      "url": "https://doi.org/10.1002/ecy.4470"
    },
    {
      "category": "habitat",
      "text": "It lives only on high mountain plateaus, above where trees can grow.",
      "source": "iucn"
    },
    {
      "category": "geography",
      "text": "It survives in a few separate mountain ranges in Ethiopia.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Diseases like rabies, caught from village dogs, have wiped out many wolves.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "About 60% of the land above 3,200 m in its range has become farmland.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "It has five claws on each front foot.",
      "tags": [
        "five_front_claws"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its legs are very long for its body.",
      "tags": [
        "long_legs"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its snout is long, or narrows to a pointed tip.",
      "tags": [
        "pointed_snout"
      ],
      "source": "ngo"
    },
    {
      "category": "morphology",
      "text": "It has very sharp hearing and relies on it.",
      "tags": [
        "super_hearing"
      ],
      "source": "ngo",
      "url": "https://www.carnivoreconservation.org/files/actionplans/canids.pdf"
    },
    {
      "category": "morphology",
      "text": "It has a patch of contrasting color on its throat.",
      "tags": [
        "throat_patch"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its belly is plain white.",
      "tags": [
        "white_belly"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its fur is mostly red, reddish brown or golden red.",
      "tags": [
        "reddish_fur"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its face has bold markings in a contrasting color, such as patches, rings or lines.",
      "tags": [
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It digs into the ground on land, for example making burrows, tunnels or dens, or digging itself down into soil or sand.",
      "tags": [
        "burrower"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It leaves its dung in piles that it comes back to, as messages to others of its kind.",
      "tags": [
        "dung_piles"
      ],
      "source": "smithsonian",
      "url": "https://repository.si.edu/server/api/core/bitstreams/c7f5c08e-8561-46ed-b081-eaacaf649db9/content"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes loud calls that carry far, such as songs, hoots, barks, roars or wails.",
      "tags": [
        "loud_calls"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It shares food with, or brings food to, members of its group other than its own young.",
      "tags": [
        "shares_food"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It gathers food and stores it to eat later.",
      "tags": [
        "stores_food"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Rodents are a main part of its prey.",
      "tags": [
        "rodent_hunter"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It defends an area, such as a territory, home patch or den site, against others of its kind.",
      "tags": [
        "territorial"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly in grassy meadows high on mountainsides.",
      "tags": [
        "mountain_meadows"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly in the open zone high on mountains above the tree line, where it is too cold for trees to grow.",
      "tags": [
        "above_tree_line"
      ],
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the world's rarest wild dog, and Africa's most endangered carnivore.",
      "source": "news",
      "url": "https://www.science.org/content/article/watch-ethiopian-wolves-drink-flower-nectar-first-large-carnivore"
    },
    {
      "category": "key_fact",
      "text": "In 2024 scientists found it may help pollinate flowers: pollen sticks to its muzzle as it licks nectar.",
      "source": "literature",
      "url": "https://doi.org/10.1002/ecy.4470"
    },
    {
      "category": "key_fact",
      "text": "A 2024 count found about 450 wolves in 99 packs.",
      "source": "ngo"
    },
    {
      "category": "behavior",
      "text": "Packs meet at dawn, midday and evening to greet each other and patrol.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Pups are born in a den under a boulder or in a rock crack, and every adult in the pack helps feed them.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "In the north, farms push the wolves up above 3,500 m.",
      "source": "iucn"
    }
  ],
  "sources": {
