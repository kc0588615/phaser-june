  "clues": [
    {
      "category": "morphology",
      "text": "It has a red coat with a white throat and a white crescent under each eye.",
      "tags": [
        "reddish_fur",
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It lives in a pack, but each wolf hunts on its own.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Packs patrol their borders and mark them with scent.",
      "tags": [
        "territorial",
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It hunts rodents, especially the big giant mole-rat.",
      "tags": [
        "rodent_hunter"
      ],
      "source": "iucn"
    },
    {
      "category": "diet",
      "text": "It licks sweet nectar from red hot poker flowers.",
      "tags": [
        "nectar_drinker"
      ],
      "source": "literature",
      "url": "https://doi.org/10.1002/ecy.4470"
    },
    {
      "category": "habitat",
      "text": "It lives only on high mountain plateaus, above where trees can grow.",
      "tags": [
        "high_mountains"
      ],
      "source": "iucn"
    },
    {
      "category": "geography",
      "text": "It survives in a few separate mountain ranges in Ethiopia.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Diseases like rabies, caught from village dogs, have wiped out many wolves.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "About 60% of the land above 3,200 m in its range has become farmland.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the world's rarest wild dog, and Africa's most endangered carnivore.",
      "source": "news",
      "url": "https://www.science.org/content/article/watch-ethiopian-wolves-drink-flower-nectar-first-large-carnivore"
    },
    {
      "category": "key_fact",
      "text": "In 2024 scientists found it may help pollinate flowers: pollen sticks to its muzzle as it licks nectar.",
      "source": "literature",
      "url": "https://doi.org/10.1002/ecy.4470"
    },
    {
      "category": "key_fact",
      "text": "A 2024 count found about 450 wolves in 99 packs.",
      "source": "ngo"
    },
    {
      "category": "behavior",
      "text": "Packs meet at dawn, midday and evening to greet each other and patrol.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Pups are born in a den under a boulder or in a rock crack, and every adult in the pack helps feed them.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "In the north, farms push the wolves up above 3,500 m.",
      "source": "iucn"
    }
  ],
