    },
    {
      "category": "behavior",
      "text": "It climbs in the trees but also spends time on the ground.",
      "tags": [
        "climber"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It can call without moving its face at all, like a ventriloquist.",
      "source": "adw"
    },
    {
      "category": "geography",
      "text": "It lives only in the mountains of central China.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Forest cleared for farming is its biggest threat.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It handles cold better than any other primate except humans.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Golden_snub-nosed_monkey"
    },
    {
      "category": "key_fact",
      "text": "Summer groups of up to 600 monkeys are a huge crowd for any primate except humans.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "Pairs sometimes call back and forth in duets, a bit like songbirds.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "When cold weather comes, big groups split into bands of 60 to 70 and join up again in spring.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Babies are born about 7 months after their parents mate.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Illegal hunting still threatens some groups.",
      "source": "iucn"
    }
