  "clues": [
    {
      "category": "morphology",
      "text": "Its fur is reddish brown on its back and black on its belly and legs.",
      "tags": [
        "reddish_fur"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its long, bushy tail has about 12 red and pale rings.",
      "tags": [
        "long_tail",
        "ringed_tail"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "The soles of its feet are covered in thick fur.",
      "tags": [
        "furry_feet"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has a 'false thumb', a long wrist bone that helps it grip bamboo.",
      "tags": [
        "false_thumb"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Red_panda"
    },
    {
      "category": "diet",
      "text": "Bamboo leaves are its main food. It bends the stems down to reach them.",
      "tags": [
        "bamboo_eater"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It sleeps high in the trees and climbs down trunks headfirst.",
      "tags": [
        "tree_dweller",
        "climber"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives high in the mountains, in forests with thick bamboo underneath.",
      "tags": [
        "high_mountains",
        "bamboo_forest"
      ],
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Losing and breaking up its forests is its main threat.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It isn't a bear or a raccoon. It is the only living member of its own family.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Red_panda"
    },
    {
      "category": "key_fact",
      "text": "The giant panda also has a 'false thumb' for bamboo, though the two aren't close relatives.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Red_panda"
    },
    {
      "category": "key_fact",
      "text": "There are two kinds, the Himalayan and the Chinese red panda, which split apart about 250,000 years ago.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Red_panda"
    },
    {
      "category": "behavior",
      "text": "It washes its face with a paw, like a cat.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Cubs are born in a hollow tree or a rock crack, mostly in June.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Its numbers are thought to have fallen by half in 18 years.",
      "source": "iucn"
    }
  ],
