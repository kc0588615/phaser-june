  "clues": [
    {
      "category": "morphology",
      "text": "It has 80 to 100 teeth, more than any other land mammal.",
      "tags": [
        "many_teeth"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Giant_armadillo"
    },
    {
      "category": "morphology",
      "text": "Its curved middle front claw can be 22 cm long, the biggest claws for its size of any mammal.",
      "tags": [
        "digging_claws"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Giant_armadillo"
    },
    {
      "category": "behavior",
      "text": "It can stand up on its back legs and tail to reach into termite mounds.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It digs big burrows and rests in them during the day.",
      "tags": [
        "burrower"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Unlike some armadillos, it can't roll up into a ball.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Giant_armadillo"
    },
    {
      "category": "conservation",
      "text": "Farms replacing forest and grassland, car crashes and wildfires all threaten it.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "It has already disappeared from Uruguay.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the biggest armadillo alive today.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Giant_armadillo"
    },
    {
      "category": "key_fact",
      "text": "Its burrows are like hotels: dozens of kinds of mammals, reptiles and birds use them.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Giant_armadillo"
    },
    {
      "category": "key_fact",
      "text": "It has more teeth than almost any other land mammal, but none of them have enamel.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Giant_armadillo"
    },
    {
      "category": "life_description",
      "text": "It takes 6 to 8 years to grow up and start a family.",
      "source": "iucn"
    },
    {
      "category": "life_description",
      "text": "A mother sometimes seals the burrow entrance to keep her baby safe inside.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Giant_armadillo"
    },
    {
      "category": "threat",
      "text": "Some beekeepers go after armadillos that break into their hives for bee grubs.",
      "source": "iucn"
    }
  ],
