  "clues": [
    {
      "category": "morphology",
      "text": "It has huge, rabbit-like ears.",
      "tags": [
        "big_ears"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has a long, pointed snout with a pink nose.",
      "tags": [
        "pointed_snout"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its tail is black with a pure white tip.",
      "tags": [
        "white_tail_tip"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Its long, sticky tongue is perfect for catching termites.",
      "tags": [
        "long_tongue"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It digs deep burrows that spiral down as far as 3 m.",
      "tags": [
        "burrower"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It gallops across the desert instead of hopping.",
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Its pouch opens backward, so it doesn't fill with dirt when it digs.",
      "tags": [
        "pouch",
        "backward_pouch"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Foxes and feral cats brought to Australia are its biggest threat.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "One bilby may dig more than 12 burrows around its home area.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "Its huge ears help it hear well in the dark.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Greater_bilby"
    },
    {
      "category": "key_fact",
      "text": "Many bilbies now live inside fenced areas that keep foxes and cats out.",
      "source": "iucn"
    },
    {
      "category": "life_description",
      "text": "A tiny newborn crawls into its mother's pouch and stays there for about 75 days.",
      "source": "adw"
    },
    {
      "category": "diet_prey",
      "text": "It gets most of its food by digging, often leaving small pits in the ground.",
      "source": "iucn"
    },
    {
      "category": "threat",
      "text": "Changes in how often wildfires burn also harm it.",
      "source": "iucn"
    }
  ],
