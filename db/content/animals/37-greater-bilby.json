  "traits": {
    "covering": {
      "value": "fur",
      "note": "Its soft, silky fur is bluish gray, with a white belly.",
      "source": "adw"
    },
    "size": {
      "value": "small",
      "note": "It weighs 0.6 to 2.5 kg.",
      "source": "adw"
    },
    "diet": {
      "value": "mixed",
      "note": "It eats termites, ants, beetles and spiders, plus seeds and bulbs.",
      "source": "iucn"
    },
    "activity": {
      "value": "night",
      "source": "iucn"
    },
    "social": {
      "value": "alone",
      "source": "iucn"
    },
    "trees": {
      "value": "no",
      "note": "It digs burrows and lives under the ground.",
      "source": "adw"
    },
    "birth": {
      "value": "live",
      "source": "adw"
    },
    "young": {
      "value": "one",
      "note": "A litter usually has 1 or 2 young, and a mother can have up to 4 litters a year.",
      "source": "adw"
    },
    "lifespan": {
      "value": "medium",
      "note": "Bilbies in zoos have lived up to 10 years.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "It has huge, rabbit-like ears.",
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has a long, pointed snout with a pink nose.",
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its tail is black with a pure white tip.",
      "tags": [
        "white_tail_tip"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Its long, sticky tongue is perfect for catching termites.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It digs deep burrows that spiral down as far as 3 m.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It gallops across the desert instead of hopping.",
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Its pouch opens backward, so it doesn't fill with dirt when it digs.",
      "tags": [
        "backward_pouch",
        "burrower"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Foxes and feral cats brought to Australia are its biggest threat.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "It has one or more stripes: long bands of a contrasting color on its body or legs.",
      "tags": [
        "stripes"
      ],
      "source": "government",
      "url": "https://www.dcceew.gov.au/sites/default/files/env/pages/a117ced5-9a94-4586-afdb-1f333618e1e3/files/25-ind.pdf"
    },
    {
      "category": "morphology",
      "text": "It has very sharp hearing and relies on it.",
      "tags": [
        "super_hearing"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its belly is plain white.",
      "tags": [
        "white_belly"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its ears are large for its head.",
      "tags": [
        "big_ears"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its snout is long, or narrows to a pointed tip.",
      "tags": [
        "pointed_snout"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its tongue is very long and can reach far out of its mouth.",
      "tags": [
        "long_tongue"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has strong, long claws that it digs with.",
      "tags": [
        "digging_claws"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "It sees poorly or not at all, and relies mainly on smell, hearing or touch.",
      "tags": [
        "poor_eyesight"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It breaks open ant or termite nests with its claws or snout to eat the insects inside.",
      "tags": [
        "raids_termite_mounds"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It can go days or longer without drinking, getting most of its water from its food.",
      "tags": [
        "rarely_drinks"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It spreads plant seeds to new places by eating them, often in fruit, and passing them in its droppings.",
      "tags": [
        "seed_spreader"
      ],
      "source": "literature",
      "url": "https://doi.org/10.1071/wr21015"
    },
    {
      "category": "behavior",
      "text": "It can feel vibrations or ripples through the ground or water, to sense prey, danger or others.",
      "tags": [
        "senses_vibrations"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "At least sometimes, it stands, rears up, hops or runs on its back legs alone.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "literature",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10773314/"
    },
    {
      "category": "behavior",
      "text": "It digs into the ground on land, for example making burrows, tunnels or dens, or digging itself down into soil or sand.",
      "tags": [
        "burrower"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It sleeps, hides or raises its young in burrows or dens that other animals dug.",
      "tags": [
        "borrowed_burrows"
      ],
      "source": "literature",
      "url": "https://digital.library.adelaide.edu.au/server/api/core/bitstreams/ea3f6caa-93f1-4aec-97b2-6b38038d365b/content"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly on or in sand dunes, by the coast or inland.",
      "tags": [
        "sand_dunes"
      ],
      "source": "adw"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "One bilby may dig more than 12 burrows around its home area.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "Its huge ears help it hear well in the dark.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Greater_bilby"
    },
    {
      "category": "key_fact",
      "text": "Many bilbies now live inside fenced areas that keep foxes and cats out.",
      "source": "iucn"
    },
    {
      "category": "life_description",
      "text": "A tiny newborn crawls into its mother's pouch and stays there for about 75 days.",
      "source": "adw"
    },
    {
      "category": "diet_prey",
      "text": "It gets most of its food by digging, often leaving small pits in the ground.",
      "source": "iucn"
    },
    {
      "category": "threat",
      "text": "Changes in how often wildfires burn also harm it.",
      "source": "iucn"
    }
  ],
