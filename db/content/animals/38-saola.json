  "clues": [
    {
      "category": "morphology",
      "text": "Both males and females have long, straight, nearly parallel horns.",
      "tags": [
        "horns"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "White bands circle its legs just above its hooves.",
      "tags": [
        "hooves"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has white patches on its face, hiding what may be the biggest face scent glands of any mammal.",
      "tags": [
        "face_markings",
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It may mark its area by snapping small saplings with its horns.",
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in wet evergreen forests of the Annamite Mountains, where it rains all year.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Wire snares set for other animals are its biggest danger.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    },
    {
      "category": "conservation",
      "text": "Maybe only 50 to 300 adults are left.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It was discovered in 1992, the first large mammal new to science in 50 years.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    },
    {
      "category": "key_fact",
      "text": "It is so rare and hard to find that people call it the 'Asian unicorn'.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    },
    {
      "category": "key_fact",
      "text": "The last photo of a wild saola was taken by a camera trap in 2013.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    },
    {
      "category": "behavior",
      "text": "Saolas kept by people have never lived long, most only weeks or months.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "A mother carries her calf for about 8 months.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Conservation teams have removed more than 26,000 snares from its forests.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    }
  ],
