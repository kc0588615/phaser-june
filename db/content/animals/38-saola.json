  "clues": [
    {
      "category": "morphology",
      "text": "Both males and females have long, straight, nearly parallel horns.",
      "tags": [
        "horns"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "White bands circle its legs just above its hooves.",
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has white patches on its face, hiding what may be the biggest face scent glands of any mammal.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It may mark its area by snapping small saplings with its horns.",
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in wet evergreen forests of the Annamite Mountains, where it rains all year.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Wire snares set for other animals are its biggest danger.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    },
    {
      "category": "conservation",
      "text": "Maybe only 50 to 300 adults are left.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its fur is black or nearly black all over, at least in some individuals.",
      "tags": [
        "black_coat"
      ],
      "source": "literature",
      "url": "https://doi.org/10.1017/S0030605300020974"
    },
    {
      "category": "morphology",
      "text": "It has large scent glands just below or in front of its eyes.",
      "tags": [
        "eye_glands"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its tongue is very long and can reach far out of its mouth.",
      "tags": [
        "long_tongue"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    },
    {
      "category": "morphology",
      "text": "It has one or more stripes: long bands of a contrasting color on its body or legs.",
      "tags": [
        "stripes"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has a patch of contrasting color on its throat.",
      "tags": [
        "throat_patch"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    },
    {
      "category": "morphology",
      "text": "Its toes end in hard hooves that it walks on.",
      "tags": [
        "hooves"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It lives and feeds on the forest floor, and rarely if ever climbs up into the trees.",
      "tags": [
        "forest_floor"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Leaves are a main part of its food.",
      "tags": [
        "leaf_eater"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It never climbs trees: it stays on or under the ground, or in water.",
      "tags": [
        "never_climbs"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It visits salt licks, or eats mineral-rich soil, clay or water, to get minerals.",
      "tags": [
        "salt_licks"
      ],
      "source": "ngo",
      "url": "https://awsassets.panda.org/downloads/saolaproceedingenglish.pdf"
    },
    {
      "category": "morphology",
      "text": "Its face has bold markings in a contrasting color, such as patches, rings or lines.",
      "tags": [
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly in forest with a thick undergrowth of bamboo.",
      "tags": [
        "bamboo_forest"
      ],
      "source": "literature",
      "url": "https://doi.org/10.1017/S0030605300020974"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It was discovered in 1992, the first large mammal new to science in 50 years.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    },
    {
      "category": "key_fact",
      "text": "It is so rare and hard to find that people call it the 'Asian unicorn'.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    },
    {
      "category": "key_fact",
      "text": "The last photo of a wild saola was taken by a camera trap in 2013.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    },
    {
      "category": "behavior",
      "text": "Saolas kept by people have never lived long, most only weeks or months.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "A mother carries her calf for about 8 months.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Conservation teams have removed more than 26,000 snares from its forests.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Saola"
    }
  ],
