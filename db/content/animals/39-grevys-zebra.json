  "clues": [
    {
      "category": "morphology",
      "text": "Its stripes are narrow and run all the way down its legs to its hooves.",
      "tags": [
        "stripes",
        "hooves"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Gr%C3%A9vy%27s_zebra"
    },
    {
      "category": "morphology",
      "text": "Its belly is plain white, with no stripes.",
