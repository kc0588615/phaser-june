  "clues": [
    {
      "category": "morphology",
      "text": "Its long reddish hair covers its body and face.",
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its arms stretch about 2.25 m from fingertip to fingertip, much longer than its legs.",
      "tags": [
        "long_arms"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Grown males have big cheek pads.",
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Fruit is its main food.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It builds a nest of branches in the trees to sleep in each night.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Orangutan"
    },
    {
      "category": "behavior",
      "text": "It lives almost entirely in the trees; females almost never touch the ground.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It uses sticks as tools to get termites, honey and seeds.",
      "tags": [
        "uses_tools"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Sumatran_orangutan"
    },
    {
      "category": "geography",
      "text": "It lives only in the north of the island of Sumatra, in Indonesia.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Forest cleared for farms and plantations, and illegal killing, are its main threats.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its body is bright red-orange.",
      "tags": [
        "red_orange"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It bites or chews with unusual force for its size.",
      "tags": [
        "strong_bite"
      ],
      "source": "literature",
      "url": "https://www.nature.com/articles/s41598-019-42856-w"
    },
    {
      "category": "morphology",
      "text": "Its fur is mostly red, reddish brown or golden red.",
      "tags": [
        "reddish_fur"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Leaves are a main part of its food.",
      "tags": [
        "leaf_eater"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It makes loud calls that carry far, such as songs, hoots, barks, roars or wails.",
      "tags": [
        "loud_calls"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It drinks nectar from flowers.",
      "tags": [
        "nectar_drinker"
      ],
      "source": "adw",
      "url": "https://animaldiversity.org/accounts/Pongo/"
    },
    {
      "category": "behavior",
      "text": "It rests by hanging or perching in tree branches.",
      "tags": [
        "roosts_in_trees"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/orangutans/behavior"
    },
    {
      "category": "diet",
      "text": "It spreads plant seeds to new places by eating them, often in fruit, and passing them in its droppings.",
      "tags": [
        "seed_spreader"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It sleeps or rests high up in trees.",
      "tags": [
        "sleeps_high_in_trees"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes high squeaking calls.",
      "tags": [
        "squeaker"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "At least sometimes, it stands, rears up, hops or runs on its back legs alone.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/orangutans/behavior"
    },
    {
      "category": "behavior",
      "text": "It defends an area, such as a territory, home patch or den site, against others of its kind.",
      "tags": [
        "territorial"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It walks on its knuckles or the sides of its curled front feet, keeping its claws or fingers off the ground.",
      "tags": [
        "walks_on_knuckles"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Orangutan"
    },
    {
      "category": "behavior",
      "text": "It climbs well or often, in trees, on rocks or both.",
      "tags": [
        "climber"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Orangutan"
    },
    {
      "category": "diet",
      "text": "Fruit is a main or favorite part of its food.",
      "tags": [
        "fruit_eater"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It lives in trees and seldom comes down to the ground.",
      "tags": [
        "seldom_on_ground"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It builds a nest or bed of leaves, branches or grass to sleep or rest in.",
      "tags": [
        "sleeping_nests"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Orangutan"
    },
    {
      "category": "habitat",
      "text": "In some places it lives in or near human settlements, such as towns, villages, gardens, parks or plantations.",
      "tags": [
        "town_dweller"
      ],
      "source": "literature",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3040220/"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Orangutan mothers have a baby only every 6 to 9 years, the longest gap of any great ape.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Orangutan"
    },
    {
      "category": "key_fact",
      "text": "Some orangutans keep their best stick tools, building up whole 'toolboxes'.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Sumatran_orangutan"
    },
    {
      "category": "key_fact",
      "text": "Scientists recently found a third kind of orangutan, the Tapanuli orangutan, also on Sumatra.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Sumatran_orangutan"
    },
    {
      "category": "behavior",
      "text": "When building its nest, an orangutan may smack its lips or blow raspberries.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Orangutan"
    },
    {
      "category": "life_description",
      "text": "Young orangutans learn to build nests by watching their mothers.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Orangutan"
    },
    {
      "category": "threat",
      "text": "Even careful logging can cut the number of orangutans in a forest by up to 60%.",
      "source": "iucn"
    }
  ],
