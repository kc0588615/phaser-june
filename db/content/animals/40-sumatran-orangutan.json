  "facts": [
    {
      "category": "key_fact",
      "text": "Orangutan mothers have a baby only every 6 to 9 years, the longest gap of any great ape.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Orangutan"
    },
    {
      "category": "key_fact",
      "text": "Some orangutans keep their best stick tools, building up whole 'toolboxes'.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Sumatran_orangutan"
    },
    {
      "category": "key_fact",
      "text": "Scientists recently found a third kind of orangutan, the Tapanuli orangutan, also on Sumatra.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Sumatran_orangutan"
    },
    {
      "category": "behavior",
      "text": "When building its nest, an orangutan may smack its lips or blow raspberries.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Orangutan"
    },
    {
      "category": "life_description",
      "text": "Young orangutans learn to build nests by watching their mothers.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Orangutan"
    },
    {
      "category": "threat",
      "text": "Even careful logging can cut the number of orangutans in a forest by up to 60%.",
      "source": "iucn"
    }
