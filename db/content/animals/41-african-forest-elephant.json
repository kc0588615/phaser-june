  "clues": [
    {
      "category": "morphology",
      "text": "Both males and females have straight tusks that point down.",
      "tags": [
        "tusks"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/African_forest_elephant"
    },
    {
      "category": "morphology",
      "text": "It has big, rounded ears and fans them to cool off.",
      "tags": [
        "big_ears"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Its feet can feel rumbles through the ground from up to 16 km away.",
      "tags": [
        "senses_vibrations"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It picks fruit with its trunk and spreads the seeds in its droppings, sometimes 5 km away.",
      "tags": [
        "trunk",
        "fruit_eater",
        "seed_spreader"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/African_forest_elephant"
    },
    {
      "category": "diet",
      "text": "It travels long distances to reach places with mineral salts.",
      "tags": [
        "salt_licks"
      ],
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Poaching for ivory rose sharply after 2008 and is still too high.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Its numbers fell by more than 80% in 93 years.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "In 2021 the Red List judged it separately from the savanna elephant for the first time, and listed it as Critically Endangered.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "Some rainforest trees depend on it to spread their big seeds.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "It is smaller than the savanna elephant, and its tusks hang straight down to fit through thick forest.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "After a mud bath, its gray skin can look yellow or reddish.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/African_forest_elephant"
    },
    {
      "category": "life_description",
      "text": "Mothers can nurse their young for up to 6.5 years.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Farms, roads and towns spreading into its forests lead to more run-ins with people.",
      "source": "iucn"
    }
  ],
