      "source": "adw"
    },
    "birth": {
      "value": "live",
      "source": "adw"
    },
    "young": {
      "value": "one",
      "note": "A mother has a calf only every 4 to 9 years.",
      "source": "adw"
    },
    "lifespan": {
      "value": "long",
      "note": "It can live 60 to 70 years.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "Both males and females have straight tusks that point down.",
      "tags": [
        "tusks"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/African_forest_elephant"
    },
    {
      "category": "morphology",
      "text": "It has big, rounded ears and fans them to cool off.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Its feet can feel rumbles through the ground from up to 16 km away.",
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It picks fruit with its trunk and spreads the seeds in its droppings, sometimes 5 km away.",
      "tags": [
        "trunk",
        "fruit_eater",
        "seed_spreader"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/African_forest_elephant"
    },
    {
      "category": "diet",
      "text": "It travels long distances to reach places with mineral salts.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Poaching for ivory rose sharply after 2008 and is still too high.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Its numbers fell by more than 80% in 93 years.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Some of its teeth keep growing all its life.",
      "tags": [
        "ever_growing_teeth"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/african_elephant/characteristics"
    },
    {
      "category": "morphology",
      "text": "It has very sharp hearing and relies on it.",
      "tags": [
        "super_hearing"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its ears are large for its head.",
      "tags": [
        "big_ears"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It lives and feeds on the forest floor, and rarely if ever climbs up into the trees.",
      "tags": [
        "forest_floor"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Leaves are a main part of its food.",
      "tags": [
        "leaf_eater"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes loud calls that carry far, such as songs, hoots, barks, roars or wails.",
      "tags": [
        "loud_calls"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It calls with deep, low rumbles, some too low for people to hear.",
      "tags": [
        "low_rumbles"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It wallows in mud, or coats itself with mud, to cool off or protect its skin.",
      "tags": [
        "mud_bather"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/african_elephant/characteristics"
    },
    {
      "category": "behavior",
      "text": "It never climbs trees: it stays on or under the ground, or in water.",
      "tags": [
        "never_climbs"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It pushes or knocks over whole trees to feed.",
      "tags": [
        "pushes_over_trees"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It can breathe through the tip of its raised nose, snout or trunk while the rest of its body stays under water.",
      "tags": [
        "snorkel_nose"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "At least sometimes, it stands, rears up, hops or runs on its back legs alone.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/african_elephant/behavior"
    },
    {
      "category": "behavior",
      "text": "It swims well or often.",
      "tags": [
        "swimmer"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It visits salt licks, or eats mineral-rich soil, clay or water, to get minerals.",
      "tags": [
        "salt_licks"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It can feel vibrations or ripples through the ground or water, to sense prey, danger or others.",
      "tags": [
        "senses_vibrations"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "In some places it lives in or near human settlements, such as towns, villages, gardens, parks or plantations.",
      "tags": [
        "town_dweller"
      ],
      "source": "literature",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6040693/"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "In 2021 the Red List judged it separately from the savanna elephant for the first time, and listed it as Critically Endangered.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "Some rainforest trees depend on it to spread their big seeds.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "It is smaller than the savanna elephant, and its tusks hang straight down to fit through thick forest.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "After a mud bath, its gray skin can look yellow or reddish.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/African_forest_elephant"
    },
    {
      "category": "life_description",
      "text": "Mothers can nurse their young for up to 6.5 years.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Farms, roads and towns spreading into its forests lead to more run-ins with people.",
      "source": "iucn"
    }
  ],
