  "clues": [
    {
      "category": "morphology",
      "text": "It has white patches on its nose, chin, forehead and chest.",
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its front teeth never stop growing, like all rodents'.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Rodent"
    },
    {
      "category": "behavior",
      "text": "It sleeps through the winter in its burrow for about 7 months.",
      "tags": [
        "winter_rest",
        "burrower"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It digs its burrows under big rocks, and uses the rocks as lookouts.",
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives in steep mountain meadows above the forest.",
      "tags": [
        "mountain_meadows"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives only on Vancouver Island, off the west coast of Canada.",
      "tags": [
        "one_island"
      ],
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "In 2004 only about 35 were left in the wild.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its face has bold markings in a contrasting color, such as patches, rings or lines.",
      "tags": [
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Some of its teeth keep growing all its life.",
      "tags": [
        "ever_growing_teeth"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Rodent"
    },
    {
      "category": "behavior",
      "text": "It often rests in the sun to warm its body.",
      "tags": [
        "basker"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It climbs up big rocks, boulders or cliffs.",
      "tags": [
        "climbs_boulders"
      ],
      "source": "government",
      "url": "https://www2.gov.bc.ca/assets/gov/environment/plants-animals-and-ecosystems/species-ecosystems-at-risk/brochures/vancouver_island_marmot.pdf"
    },
    {
      "category": "behavior",
      "text": "It hides in narrow cracks and gaps between or under rocks.",
      "tags": [
        "crevice_hider"
      ],
      "source": "government",
      "url": "https://www.canada.ca/en/environment-climate-change/services/species-risk-public-registry/recovery-strategies/vancouver-island-marmot-2020.html"
    },
    {
      "category": "morphology",
      "text": "It has strong, long claws that it digs with.",
      "tags": [
        "digging_claws"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It mostly eats grass or other low plants that it crops from the ground.",
      "tags": [
        "grazer"
      ],
      "source": "iucn"
    },
    {
      "category": "diet",
      "text": "Leaves are a main part of its food.",
      "tags": [
        "leaf_eater"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It makes loud calls that carry far, such as songs, hoots, barks, roars or wails.",
      "tags": [
        "loud_calls"
      ],
      "source": "government",
      "url": "https://www2.gov.bc.ca/assets/gov/environment/plants-animals-and-ecosystems/species-ecosystems-at-risk/brochures/vancouver_island_marmot.pdf"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It builds a nest or bed of leaves, branches or grass to sleep or rest in.",
      "tags": [
        "sleeping_nests"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "At least sometimes, it stands, rears up, hops or runs on its back legs alone.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It defends an area, such as a territory, home patch or den site, against others of its kind.",
      "tags": [
        "territorial"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It calls with high whistles.",
      "tags": [
        "whistle_calls"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It digs into the ground on land, for example making burrows, tunnels or dens, or digging itself down into soil or sand.",
      "tags": [
        "burrower"
      ],
      "source": "adw"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Zoo-bred marmots were released to rebuild the wild population, which grew to just over 250 by 2021.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Vancouver_Island_marmot"
    },
    {
      "category": "key_fact",
      "text": "Logging first opened up new meadows for marmots, but few survived the winters there.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "It loses about a third of its weight while it hibernates.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Vancouver_Island_marmot"
    },
    {
      "category": "behavior",
      "text": "Its burrows must go below the frost line, where it stays at least 5 °C all winter.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Pups are born black-brown and turn reddish brown by summer.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Most deaths happen during hibernation or to predators like wolves, cougars and golden eagles.",
      "source": "iucn"
    }
  ],
