  "clues": [
    {
      "category": "morphology",
      "text": "It has white patches on its nose, chin, forehead and chest.",
      "tags": [
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its front teeth never stop growing, like all rodents'.",
      "tags": [
        "ever_growing_teeth"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Rodent"
    },
    {
      "category": "behavior",
      "text": "It sleeps through the winter in its burrow for about 7 months.",
      "tags": [
        "winter_rest",
        "burrower"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It digs its burrows under big rocks, and uses the rocks as lookouts.",
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives in steep mountain meadows above the forest.",
      "tags": [
        "mountain_meadows"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives only on Vancouver Island, off the west coast of Canada.",
      "tags": [
        "one_island"
      ],
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "In 2004 only about 35 were left in the wild.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Zoo-bred marmots were released to rebuild the wild population, which grew to just over 250 by 2021.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Vancouver_Island_marmot"
    },
    {
      "category": "key_fact",
      "text": "Logging first opened up new meadows for marmots, but few survived the winters there.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "It loses about a third of its weight while it hibernates.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Vancouver_Island_marmot"
    },
    {
      "category": "behavior",
      "text": "Its burrows must go below the frost line, where it stays at least 5 °C all winter.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Pups are born black-brown and turn reddish brown by summer.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Most deaths happen during hibernation or to predators like wolves, cougars and golden eagles.",
      "source": "iucn"
    }
  ],
