  "clues": [
    {
      "category": "morphology",
      "text": "Its fur is chestnut to red-brown, with yellow cheeks and feet.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Goodfellow%27s_tree-kangaroo"
    },
    {
      "category": "morphology",
      "text": "It has two golden stripes down its back.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Goodfellow%27s_tree-kangaroo"
    },
    {
      "category": "morphology",
      "text": "Its long, golden-brown tail helps it balance in the trees.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Goodfellow%27s_tree-kangaroo"
    },
    {
      "category": "behavior",
      "text": "It lives in the treetops, gripping branches with strong arms and hooked claws.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Goodfellow%27s_tree-kangaroo"
    },
    {
      "category": "reproduction",
      "text": "Its pouch opens forward, like other kangaroos'.",
      "tags": [
        "pouch"
      ],
      "source": "adw"
    },
    {
      "category": "geography",
      "text": "It lives in the mountain rainforests of New Guinea.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Hunting for food is its biggest threat, and it has vanished from much of its old range.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its face has bold markings in a contrasting color, such as patches, rings or lines.",
      "tags": [
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has a patch of contrasting color on its throat.",
      "tags": [
        "throat_patch"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its fur is mostly red, reddish brown or golden red.",
      "tags": [
        "reddish_fur"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Goodfellow%27s_tree-kangaroo"
    },
    {
      "category": "morphology",
      "text": "It has one or more stripes: long bands of a contrasting color on its body or legs.",
      "tags": [
        "stripes"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Goodfellow%27s_tree-kangaroo"
    },
    {
      "category": "diet",
      "text": "Leaves are a main part of its food.",
      "tags": [
        "leaf_eater"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It rests by hanging or perching in tree branches.",
      "tags": [
        "roosts_in_trees"
      ],
      "source": "literature",
      "url": "https://www.mdpi.com/2673-5636/3/1/9"
    },
    {
      "category": "behavior",
      "text": "It sleeps or rests high up in trees.",
      "tags": [
        "sleeps_high_in_trees"
      ],
      "source": "literature",
      "url": "https://www.mdpi.com/2673-5636/3/1/9"
    },
    {
      "category": "behavior",
      "text": "At least sometimes, it stands, rears up, hops or runs on its back legs alone.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/buerger-matschie-treekangaroos/behavior"
    },
    {
      "category": "behavior",
      "text": "It defends an area, such as a territory, home patch or den site, against others of its kind.",
      "tags": [
        "territorial"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It climbs well or often, in trees, on rocks or both.",
      "tags": [
        "climber"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Goodfellow%27s_tree-kangaroo"
    },
    {
      "category": "morphology",
      "text": "Its tail is long: at least two-thirds as long as its head and body.",
      "tags": [
        "long_tail"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly high up in mountains: on upper slopes, high plateaus or alpine zones, not just foothills.",
      "tags": [
        "high_mountains"
      ],
      "source": "adw"
    },
    {
      "category": "geography",
      "text": "Its entire natural wild range is, or was, on a single island.",
      "tags": [
        "one_island"
      ],
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is a kangaroo that lives in trees, and its front and back legs are closer in size than a ground kangaroo's.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Goodfellow%27s_tree-kangaroo"
    },
    {
      "category": "key_fact",
      "text": "It is also called the ornate tree-kangaroo.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Goodfellow%27s_tree-kangaroo"
    },
    {
      "category": "key_fact",
      "text": "It has a swirl of hair in the middle of its back.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "A newborn climbs into the pouch on its own and grows there for 10 to 12 months.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "It once lived in lowland forest too, but now survives only in mountain forest.",
      "source": "iucn"
    },
    {
      "category": "threat",
      "text": "Coffee farms and fields are replacing its forest.",
      "source": "iucn"
    }
  ],
