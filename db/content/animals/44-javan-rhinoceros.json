  "clues": [
    {
      "category": "morphology",
      "text": "Males have a single short horn, less than 25 cm long; females often have none.",
      "tags": [
        "horns"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its skin has deep folds that make it look like it wears plates of armor.",
      "tags": [
        "skin_folds"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its pointed upper lip can grab leaves and twigs.",
      "tags": [
        "grasping_lip"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It spends much of the day wallowing in mud pools.",
      "tags": [
        "mud_bather"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It is a good swimmer.",
      "tags": [
        "swimmer"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It visits salt licks for minerals.",
      "tags": [
        "salt_licks"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Javan_rhinoceros"
    },
    {
      "category": "geography",
      "text": "It once lived from India to Vietnam, but now survives in just one national park on the island of Java.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Only a few dozen are left, all in one place.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is one of the rarest large mammals on Earth.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Javan_rhinoceros"
    },
    {
      "category": "key_fact",
      "text": "Its horn is smaller than any other rhino's, so it's also called the lesser one-horned rhino.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "In 2011 hidden cameras filmed two mothers with calves, proof that they still breed in the wild.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Javan_rhinoceros"
    },
    {
      "category": "behavior",
      "text": "It can walk up to 20 km in a day while it feeds.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "A mother carries her calf for about 16 months.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "A fast-spreading palm called langkap is crowding out the plants it eats.",
      "source": "iucn"
    },
    {
      "category": "threat",
      "text": "Poaching for its horn wiped it out everywhere else it lived.",
      "source": "iucn"
    }
  ],
