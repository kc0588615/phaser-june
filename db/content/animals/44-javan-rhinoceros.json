  "clues": [
    {
      "category": "morphology",
      "text": "Males have a single short horn, less than 25 cm long; females often have none.",
      "tags": [
        "horns"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its skin has deep folds that make it look like it wears plates of armor.",
      "tags": [
        "skin_folds"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its pointed upper lip can grab leaves and twigs.",
      "tags": [
        "grasping_lip"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It spends much of the day wallowing in mud pools.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It is a good swimmer.",
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It visits salt licks for minerals.",
      "tags": [
        "salt_licks"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Javan_rhinoceros"
    },
    {
      "category": "geography",
      "text": "It once lived from India to Vietnam, but now survives in just one national park on the island of Java.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Only a few dozen are left, all in one place.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its toes end in hard hooves that it walks on.",
      "tags": [
        "hooves"
      ],
      "source": "adw",
      "url": "https://animaldiversity.org/accounts/Rhinocerotidae/"
    },
    {
      "category": "behavior",
      "text": "It leaves its dung in piles that it comes back to, as messages to others of its kind.",
      "tags": [
        "dung_piles"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Javan_rhinoceros"
    },
    {
      "category": "behavior",
      "text": "It lives and feeds on the forest floor, and rarely if ever climbs up into the trees.",
      "tags": [
        "forest_floor"
      ],
      "source": "iucn"
    },
    {
      "category": "diet",
      "text": "Fruit is a main or favorite part of its food.",
      "tags": [
        "fruit_eater"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Javan_rhinoceros"
    },
    {
      "category": "diet",
      "text": "Leaves are a main part of its food.",
      "tags": [
        "leaf_eater"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It makes loud calls that carry far, such as songs, hoots, barks, roars or wails.",
      "tags": [
        "loud_calls"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It never climbs trees: it stays on or under the ground, or in water.",
      "tags": [
        "never_climbs"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It sees poorly or not at all, and relies mainly on smell, hearing or touch.",
      "tags": [
        "poor_eyesight"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It swims well or often.",
      "tags": [
        "swimmer"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It calls with high whistles.",
      "tags": [
        "whistle_calls"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It wallows in mud, or coats itself with mud, to cool off or protect its skin.",
      "tags": [
        "mud_bather"
      ],
      "source": "adw"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is one of the rarest large mammals on Earth.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Javan_rhinoceros"
    },
    {
      "category": "key_fact",
      "text": "Its horn is smaller than any other rhino's, so it's also called the lesser one-horned rhino.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "In 2011 hidden cameras filmed two mothers with calves, proof that they still breed in the wild.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Javan_rhinoceros"
    },
    {
      "category": "behavior",
      "text": "It can walk up to 20 km in a day while it feeds.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "A mother carries her calf for about 16 months.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "A fast-spreading palm called langkap is crowding out the plants it eats.",
      "source": "iucn"
    },
    {
      "category": "threat",
      "text": "Poaching for its horn wiped it out everywhere else it lived.",
      "source": "iucn"
    }
  ],
