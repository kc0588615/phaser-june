    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It was discovered in 1983 by Li Weidong, then not seen again until he found it once more in 2014.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Ili_pika"
    },
    {
      "category": "key_fact",
      "text": "Its nickname is the 'magic rabbit', and photos of it went viral in 2015.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Ili_pika"
    },
    {
      "category": "key_fact",
      "text": "Pikas are relatives of rabbits and hares.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Ili_pika"
    },
    {
      "category": "threat",
      "text": "Its numbers fell by about 70% in 15 years.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Ili_pika"
    },
    {
      "category": "threat",
      "text": "Mastiff dogs kept by herders also hunt pikas.",
