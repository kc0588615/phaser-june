  "clues": [
    {
      "category": "behavior",
      "text": "It makes loud, spooky screeches, especially when feeding.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "morphology",
      "text": "Its huge head and jaws give it one of the strongest bites for its size of any land predator.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "morphology",
      "text": "It stores fat in its tail.",
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It eats almost any dead animal it finds, bones and all.",
      "tags": [
        "scavenger"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It sleeps in dens: hollow logs, caves or old wombat burrows.",
      "tags": [
        "borrowed_burrows"
      ],
      "source": "iucn"
    },
    {
      "category": "reproduction",
      "text": "Its pouch opens backward.",
      "tags": [
        "backward_pouch"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "geography",
      "text": "It survives only on the island of Tasmania, south of mainland Australia.",
      "tags": [
        "one_island"
      ],
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Since the 1990s, a disease that causes lumps on devils' faces has spread and wiped out many of them.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its fur is black or nearly black all over, at least in some individuals.",
      "tags": [
        "black_coat"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "morphology",
      "text": "It has five claws on each front foot.",
      "tags": [
        "five_front_claws"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "morphology",
      "text": "Its head is very large for its body.",
      "tags": [
        "huge_head"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has very sharp hearing and relies on it.",
      "tags": [
        "super_hearing"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "morphology",
      "text": "It has a patch of contrasting color on its throat.",
      "tags": [
        "throat_patch"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It bites or chews with unusual force for its size.",
      "tags": [
        "strong_bite"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "behavior",
      "text": "It digs into the ground on land, for example making burrows, tunnels or dens, or digging itself down into soil or sand.",
      "tags": [
        "burrower"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "behavior",
      "text": "It climbs well or often, in trees, on rocks or both.",
      "tags": [
        "climber"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/tasmaniandevil/behavior"
    },
    {
      "category": "morphology",
      "text": "It has strong, long claws that it digs with.",
      "tags": [
        "digging_claws"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "behavior",
      "text": "It leaves its dung in piles that it comes back to, as messages to others of its kind.",
      "tags": [
        "dung_piles"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It lives and feeds on the forest floor, and rarely if ever climbs up into the trees.",
      "tags": [
        "forest_floor"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It makes a loud hissing sound.",
      "tags": [
        "hisses"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/tasmaniandevil/behavior"
    },
    {
      "category": "behavior",
      "text": "It makes loud calls that carry far, such as songs, hoots, barks, roars or wails.",
      "tags": [
        "loud_calls"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It builds a nest or bed of leaves, branches or grass to sleep or rest in.",
      "tags": [
        "sleeping_nests"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "At least sometimes, it stands, rears up, hops or runs on its back legs alone.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "behavior",
      "text": "It swims well or often.",
      "tags": [
        "swimmer"
      ],
      "source": "sdzwa",
      "url": "https://ielc.libguides.com/sdzg/factsheets/tasmaniandevil/behavior"
    },
    {
      "category": "behavior",
      "text": "It makes loud, harsh screeches.",
      "tags": [
        "screecher"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the largest meat-eating marsupial in the world.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "key_fact",
      "text": "Devils once lived on mainland Australia, but disappeared from there about 3,500 years ago.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "key_fact",
      "text": "Some wild devils seem to be evolving resistance to the face disease.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "behavior",
      "text": "Adult devils may use the same dens all their lives.",
      "source": "iucn"
    },
    {
      "category": "life_description",
      "text": "Joeys stay in the pouch for about 4 months.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Cars and dogs are dangers too.",
      "source": "iucn"
    }
  ],
