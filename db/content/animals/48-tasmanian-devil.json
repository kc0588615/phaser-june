  "clues": [
    {
      "category": "behavior",
      "text": "It makes loud, spooky screeches, especially when feeding.",
      "tags": [
        "screecher"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "morphology",
      "text": "Its huge head and jaws give it one of the strongest bites for its size of any land predator.",
      "tags": [
        "strong_bite"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "morphology",
      "text": "It stores fat in its tail.",
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It eats almost any dead animal it finds, bones and all.",
      "tags": [
        "scavenger"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It sleeps in dens: hollow logs, caves or old wombat burrows.",
      "tags": [
        "borrowed_burrows"
      ],
      "source": "iucn"
    },
    {
      "category": "reproduction",
      "text": "Its pouch opens backward.",
      "tags": [
        "pouch",
        "backward_pouch"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "geography",
      "text": "It survives only on the island of Tasmania, south of mainland Australia.",
      "tags": [
        "one_island"
      ],
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Since the 1990s, a disease that causes lumps on devils' faces has spread and wiped out many of them.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the largest meat-eating marsupial in the world.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "key_fact",
      "text": "Devils once lived on mainland Australia, but disappeared from there about 3,500 years ago.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "key_fact",
      "text": "Some wild devils seem to be evolving resistance to the face disease.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Tasmanian_devil"
    },
    {
      "category": "behavior",
      "text": "Adult devils may use the same dens all their lives.",
      "source": "iucn"
    },
    {
      "category": "life_description",
      "text": "Joeys stay in the pouch for about 4 months.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Cars and dogs are dangers too.",
      "source": "iucn"
    }
  ],
