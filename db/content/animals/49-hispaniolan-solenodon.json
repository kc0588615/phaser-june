  "clues": [
    {
      "category": "morphology",
      "text": "It is one of the few venomous mammals: venom flows along a groove in a lower front tooth.",
      "tags": [
        "venomous"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its long, bendy snout is held up by a special bone of its own.",
      "tags": [
        "pointed_snout"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It roots in the soil with its snout and rips open rotten logs with its claws.",
      "tags": [
        "digging_claws"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "By day it rests in rock cracks, hollow trees or tunnels it digs.",
      "tags": [
        "burrower"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It runs in a wobbly zigzag.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Hispaniolan_solenodon"
    },
    {
      "category": "geography",
      "text": "It lives only on the island of Hispaniola, shared by Haiti and the Dominican Republic.",
      "tags": [
        "one_island"
      ],
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Dogs, cats and mongooses brought to the island hunt it.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its family split from all other living mammals about 78 million years ago, when dinosaurs still roamed.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Hispaniolan_solenodon"
    },
    {
      "category": "key_fact",
      "text": "By 1964 people thought it was extinct, but it has turned out to be more widespread than anyone knew.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "A mother has only two teats, so usually just two babies survive.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Hispaniolan_solenodon"
    },
    {
      "category": "behavior",
      "text": "When chased, it sometimes freezes and tucks its head out of sight.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "It is doing well across much of Hispaniola, but in Haiti it clings on in a small area where forests are disappearing.",
      "source": "iucn"
    }
  ],
