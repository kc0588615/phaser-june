  "clues": [
    {
      "category": "morphology",
      "text": "Both males and females have long horns that twist in 1.5 to 3 spirals.",
      "tags": [
        "horns",
        "spiral_horns"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its wide, spread-out hooves help it walk on soft sand.",
      "tags": [
        "hooves"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has a dark tuft of hair on its forehead and white markings on its face.",
      "tags": [
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It can go most of its life without drinking, getting water from the plants it eats.",
      "tags": [
        "rarely_drinks"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It wanders huge distances across the desert looking for fresh grazing.",
      "tags": [
        "nomadic",
        "grazer"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives in the Sahara, in some of the driest places on Earth.",
      "source": "iucn"
    },
    {
      "category": "geography",
      "text": "Wild addax survive only in Niger and Chad.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Only about 30 to 90 adults are left in the wild.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the most desert-loving of all large hoofed animals.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "It has vanished from Algeria, Egypt, Libya, Morocco, Sudan, Tunisia and Western Sahara.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "Scientists say it has recovered only about 14% of the way to healthy numbers.",
      "source": "iucn"
    },
    {
      "category": "life_description",
      "text": "A mother carries her calf for about 8.5 months.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Hunting, and oil drilling in its desert home, are its main threats.",
      "source": "iucn"
    }
  ],
