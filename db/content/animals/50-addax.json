  "clues": [
    {
      "category": "morphology",
      "text": "Both males and females have long horns that twist in 1.5 to 3 spirals.",
      "tags": [
        "spiral_horns"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its wide, spread-out hooves help it walk on soft sand.",
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has a dark tuft of hair on its forehead and white markings on its face.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It can go most of its life without drinking, getting water from the plants it eats.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It wanders huge distances across the desert looking for fresh grazing.",
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It lives in the Sahara, in some of the driest places on Earth.",
      "source": "iucn"
    },
    {
      "category": "geography",
      "text": "Wild addax survive only in Niger and Chad.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Only about 30 to 90 adults are left in the wild.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Adults have a mane: a crest or ruff of longer hair on the neck or back.",
      "tags": [
        "mane"
      ],
      "source": "smithsonian",
      "url": "https://nationalzoo.si.edu/animals/addax"
    },
    {
      "category": "morphology",
      "text": "It has a patch of contrasting color on its throat.",
      "tags": [
        "throat_patch"
      ],
      "source": "government",
      "url": "https://cb.naturalsciences.be/antelopes/Aridlands_Antelopes/addax_description_en.pdf"
    },
    {
      "category": "morphology",
      "text": "Its belly is plain white.",
      "tags": [
        "white_belly"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its toes end in hard hooves that it walks on.",
      "tags": [
        "hooves"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its face has bold markings in a contrasting color, such as patches, rings or lines.",
      "tags": [
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It never climbs trees: it stays on or under the ground, or in water.",
      "tags": [
        "never_climbs"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "smithsonian",
      "url": "https://nationalzoo.si.edu/animals/addax"
    },
    {
      "category": "behavior",
      "text": "It defends an area, such as a territory, home patch or den site, against others of its kind.",
      "tags": [
        "territorial"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It mostly eats grass or other low plants that it crops from the ground.",
      "tags": [
        "grazer"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Addax"
    },
    {
      "category": "behavior",
      "text": "It has no fixed home area: it wanders or travels long distances, following food, water or rain.",
      "tags": [
        "nomadic"
      ],
      "source": "iucn"
    },
    {
      "category": "diet",
      "text": "It can go days or longer without drinking, getting most of its water from its food.",
      "tags": [
        "rarely_drinks"
      ],
      "source": "adw"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the most desert-loving of all large hoofed animals.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "It has vanished from Algeria, Egypt, Libya, Morocco, Sudan, Tunisia and Western Sahara.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "Scientists say it has recovered only about 14% of the way to healthy numbers.",
      "source": "iucn"
    },
    {
      "category": "life_description",
      "text": "A mother carries her calf for about 8.5 months.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Hunting, and oil drilling in its desert home, are its main threats.",
      "source": "iucn"
    }
  ],
