  },
  "clues": [
    {
      "category": "morphology",
      "text": "It has no teeth, so it can't chew.",
      "tags": [
        "toothless"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its sticky tongue is up to 70 cm long.",
      "tags": [
        "long_tongue"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It digs deep to break open underground ant and termite nests with its big front claws.",
      "tags": [
        "raids_termite_mounds",
        "digging_claws"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It walks on the sides of its curled-up front feet to protect its big claws.",
      "tags": [
        "walks_on_knuckles"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Giant_pangolin"
    },
    {
      "category": "behavior",
      "text": "When in danger, it rolls into a tight ball of scales that is almost impossible to open.",
      "tags": [
        "rolls_into_ball"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "By day it sleeps in a burrow, either one it dug or an old one another animal left behind.",
      "tags": [
        "burrower",
        "borrowed_burrows"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Males and females mark their home areas with scent.",
      "tags": [
        "scent_marks"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "Even though it lives in forests, it never climbs trees.",
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "It is hunted and sold for its scales and meat.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the biggest pangolin alive, up to 1.8 m long: about as long as a tall adult.",
      "source": "literature",
      "url": "https://doi.org/10.1016/B978-0-12-815507-3.00010-1"
    },
    {
      "category": "key_fact",
      "text": "In 2023, camera traps photographed one in Senegal's Niokolo-Koba National Park, where none had been seen since 1999.",
      "source": "literature",
      "url": "https://doi.org/10.1111/aje.13279"
    },
    {
      "category": "key_fact",
      "text": "It is so hard to find that across 17 camera-trap studies it showed up at only about 1 in 8 camera spots.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It leans its heavy body on a termite mound, resting on its tail, and rips at it until part of the mound falls in.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Giant_pangolin"
    },
    {
      "category": "behavior",
      "text": "While it eats, it closes its eyes, nostrils and ears, and it can shake ants off its scales.",
      "source": "adw"
    },
    {
      "category": "diet_prey",
      "text": "It eats many kinds of ants and termites, including driver ants.",
      "source": "iucn"
    },
    {
      "category": "life_description",
      "text": "Young ones follow their mother until they are big and strong enough to open termite mounds themselves.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Giant_pangolin"
    },
    {
      "category": "threat",
      "text": "From 2012 to 2017, officials seized more than 6,000 kg of its scales, taken from about 1,700 animals.",
      "source": "iucn"
    }
  ],
