  "clues": [
    {
      "category": "morphology",
      "text": "Its peg-like back teeth are made of tiny tubes, have no enamel and keep growing all its life.",
      "tags": [
        "tube_teeth",
        "ever_growing_teeth"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Aardvark"
    },
    {
      "category": "morphology",
      "text": "Its long snout looks like a stretched-out pig's snout.",
      "tags": [
        "pointed_snout"
      ],
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Aardvark"
    },
    {
      "category": "morphology",
      "text": "It sees poorly, but its long ears hear very well.",
      "tags": [
        "poor_eyesight",
        "big_ears"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It licks up ants and termites with its long, sticky tongue and swallows them without chewing.",
      "tags": [
        "long_tongue"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It digs into ant nests and termite mounds with its strong, spade-like claws.",
      "tags": [
        "raids_termite_mounds",
        "digging_claws"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It gets almost all the water it needs from its food, so it rarely drinks.",
      "tags": [
        "rarely_drinks"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It spends the day resting in a burrow it digs itself.",
      "tags": [
        "burrower"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "If it can't dig away from danger, it stands up on its back legs and tail and defends itself with its claws.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Hunting for bushmeat may be a real threat to it in some countries, like Zambia and Mozambique.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its name means 'earth pig' in Afrikaans, but it isn't related to pigs.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Aardvark"
    },
    {
      "category": "key_fact",
      "text": "It is the only living species in its whole order of mammals, the Tubulidentata.",
      "source": "iucn"
    },
    {
      "category": "key_fact",
      "text": "It belongs to a group of African mammals that includes elephants, sengis and golden moles.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "Its old burrows become homes for warthogs, hyenas, mongooses, bats, birds and reptiles.",
      "source": "adw"
    },
    {
      "category": "diet_flora",
      "text": "The only fruit it eats is the aardvark cucumber, which grows underground. It spreads the seeds in its droppings.",
      "source": "wikipedia",
      "url": "https://en.wikipedia.org/wiki/Aardvark"
    },
    {
      "category": "behavior",
      "text": "Before heading out at night, it checks for danger at the burrow entrance, then runs out and jumps around.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "During a drought in the Kalahari, aardvarks short of food began feeding in the daytime, and many didn't survive.",
      "source": "literature",
      "url": "https://doi.org/10.3389/fphys.2020.00637"
    }
  ],
