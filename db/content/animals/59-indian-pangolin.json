  "traits": {
    "covering": {
      "value": "scales",
      "note": "Its scales are pale, yellowish brown.",
      "source": "adw"
    },
    "size": {
      "value": "medium",
      "note": "Adults weigh 10 to 20 kg.",
      "source": "iucn"
    },
    "diet": {
      "value": "insects",
      "note": "It eats mostly ants and termites.",
      "source": "iucn"
    },
    "activity": {
      "value": "night",
      "source": "iucn"
    },
    "social": {
      "value": "alone",
      "source": "iucn"
    },
    "trees": {
      "value": "no",
      "note": "It lives mainly on the ground, though it can climb with its tail and claws.",
      "source": "iucn"
    },
    "birth": {
      "value": "live",
      "source": "iucn"
    },
    "young": {
      "value": "one",
      "note": "A mother usually has one baby; twins are rare.",
      "source": "iucn"
    },
    "lifespan": {
      "value": "medium",
      "note": "One lived 19 years in a zoo.",
      "source": "iucn"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "It has no teeth at all.",
      "tags": [
        "toothless"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its sticky tongue is up to 42.5 cm long.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its thick tail is almost as long as its body and helps it climb trees.",
      "source": "iucn"
    },
    {
      "category": "diet",
      "text": "It rips open ant nests and termite mounds with its big front claws.",
      "tags": [
        "raids_termite_mounds",
        "digging_claws"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "When in danger, it curls into a tight, armored ball.",
      "tags": [
        "rolls_into_ball"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "The only sound it is known to make is a loud hiss.",
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "By day it sleeps in a deep burrow, often dug under a big rock.",
      "tags": [
        "burrower"
      ],
      "source": "iucn"
    },
    {
      "category": "reproduction",
      "text": "A mother carries her baby on her tail while she looks for food.",
      "tags": [
        "mother_carries_young"
      ],
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "It is hunted and sold for its scales and meat.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "It has five claws on each front foot.",
      "tags": [
        "five_front_claws"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its snout is long, or narrows to a pointed tip.",
      "tags": [
        "pointed_snout"
      ],
      "source": "literature",
      "url": "https://zenodo.org/records/5720440"
    },
    {
      "category": "morphology",
      "text": "Its tongue is very long and can reach far out of its mouth.",
      "tags": [
        "long_tongue"
      ],
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its tail is long: at least two-thirds as long as its head and body.",
      "tags": [
        "long_tail"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It climbs well or often, in trees, on rocks or both.",
      "tags": [
        "climber"
      ],
      "source": "iucn"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It sees poorly or not at all, and relies mainly on smell, hearing or touch.",
      "tags": [
        "poor_eyesight"
      ],
      "source": "literature",
      "url": "https://onlinelibrary.wiley.com/doi/10.1155/2014/795062"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "At least sometimes, it stands, rears up, hops or runs on its back legs alone.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "literature",
      "url": "https://onlinelibrary.wiley.com/doi/10.1155/2014/795062"
    },
    {
      "category": "behavior",
      "text": "It defends an area, such as a territory, home patch or den site, against others of its kind.",
      "tags": [
        "territorial"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes no calls: no croaks, songs, squeaks or other voice sounds.",
      "tags": [
        "voiceless"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It walks on its knuckles or the sides of its curled front feet, keeping its claws or fingers off the ground.",
      "tags": [
        "walks_on_knuckles"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes a loud hissing sound.",
      "tags": [
        "hisses"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives at least partly in dry, thorny forest or brush.",
      "tags": [
        "spiny_forest"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "In some places it lives in or near human settlements, such as towns, villages, gardens, parks or plantations.",
      "tags": [
        "town_dweller"
      ],
      "source": "iucn"
    },
    {
      "category": "reproduction",
      "text": "A mother carries her young riding or clinging on her back.",
      "tags": [
        "carries_young_on_back"
      ],
      "source": "literature",
      "url": "https://onlinelibrary.wiley.com/doi/10.1155/2014/795062"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its scales are so heavy that they make up a quarter to a third of its body weight.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "Its other name is the thick-tailed pangolin.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It walks with its big front claws tucked under its feet.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It marks the edges of its territory with urine on trees.",
      "source": "adw"
    },
    {
      "category": "diet_prey",
      "text": "In Pakistan, most of its meals are two kinds of black ants.",
      "source": "iucn"
    },
    {
      "category": "diet_prey",
      "text": "It swallows sand and small stones that help grind up insects in its stomach.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "A mother wraps her body around her baby to keep it safe.",
      "source": "iucn"
    },
    {
      "category": "threat",
      "text": "In one part of Pakistan, its numbers fell by about 79% in just two years as people caught it for its scales.",
      "source": "iucn"
    }
  ],
