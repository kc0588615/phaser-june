  "traits": {
    "covering": {
      "value": "scales",
      "note": "Its olive-brown scales cover everything except its face, throat and belly.",
      "source": "adw"
    },
    "size": {
      "value": "medium",
      "note": "It weighs 7 to 18 kg.",
      "source": "adw"
    },
    "diet": {
      "value": "insects",
      "note": "It eats mostly ants and termites.",
      "source": "adw"
    },
    "activity": {
      "value": "night",
      "source": "adw"
    },
    "social": {
      "value": "alone",
      "source": "iucn"
    },
    "trees": {
      "value": "no",
      "note": "Unlike some pangolins, it lives on the ground, not in trees.",
      "source": "ngo",
      "url": "https://savepangolins.org/what-is-a-pangolin/"
    },
    "birth": {
      "value": "live",
      "source": "adw"
    },
    "young": {
      "value": "one",
      "note": "A mother usually has a single baby.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "It has no teeth. It swallows small stones that help grind up food in its stomach.",
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its sticky tongue can be up to 25 cm long.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It walks on its back legs, using its front legs and tail now and then for balance.",
      "tags": [
        "walks_upright"
      ],
      "source": "wikipedia"
    },
    {
      "category": "diet",
      "text": "It sniffs out ant and termite nests and tears them open with its long front claws.",
      "tags": [
        "raids_termite_mounds",
        "digging_claws"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "At the first sign of danger it rolls into a ball, wrapping its tail around its body.",
      "tags": [
        "rolls_into_ball"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It can dig its own burrow, but it prefers old ones left by warthogs or aardvarks.",
      "tags": [
        "burrower",
        "borrowed_burrows"
      ],
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "It marks trees with urine and scent to leave messages for other pangolins.",
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Babies ride on their mother's back or tail until they weigh about 3 kg.",
      "tags": [
        "carries_young_on_back"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Trade in pangolins, and farms taking over its land, are its main threats.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its colors or pattern help it blend in with its surroundings, so it is hard to see.",
      "tags": [
        "camouflage"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has five claws on each front foot.",
      "tags": [
        "five_front_claws"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its tail is long: at least two-thirds as long as its head and body.",
      "tags": [
        "long_tail"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its snout is long, or narrows to a pointed tip.",
      "tags": [
        "pointed_snout"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "As an adult, it has no teeth at all.",
      "tags": [
        "toothless"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its tongue is very long and can reach far out of its mouth.",
      "tags": [
        "long_tongue"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It climbs up big rocks, boulders or cliffs.",
      "tags": [
        "climbs_boulders"
      ],
      "source": "ngo",
      "url": "https://ewt.org/wp-content/uploads/2022/11/Temmincks-Ground-Pangolin-Smutsia-temminckii_VU.pdf"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It sees poorly or not at all, and relies mainly on smell, hearing or touch.",
      "tags": [
        "poor_eyesight"
      ],
      "source": "ngo",
      "url": "https://savepangolins.org/what-is-a-pangolin/"
    },
    {
      "category": "diet",
      "text": "It can go days or longer without drinking, getting most of its water from its food.",
      "tags": [
        "rarely_drinks"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It swims well or often.",
      "tags": [
        "swimmer"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It makes no calls: no croaks, songs, squeaks or other voice sounds.",
      "tags": [
        "voiceless"
      ],
      "source": "ngo",
      "url": "https://www.pangolinsg.org/wp-content/uploads/sites/4/2020/05/Guidance-on-the-ecological-monitoring-of-pangolin_EN.pdf"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the only pangolin in southern and eastern Africa.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "It is named after the Dutch zoologist Coenraad Jacob Temminck.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Its scales are made of keratin, the same stuff as your fingernails.",
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "Its burrows can be big enough for a person to crawl into.",
      "source": "wikipedia"
    },
    {
      "category": "life_description",
      "text": "A baby weighs 200 to 500 g at birth and starts finding its own food at about 3 months old.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Electric fences on farms are a growing danger to it across its range.",
      "source": "iucn"
    }
  ],
