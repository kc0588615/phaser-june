  "traits": {
    "covering": {
      "value": "scales",
      "note": "Its olive-brown scales cover everything except its face, throat and belly.",
      "source": "adw"
    },
    "size": {
      "value": "medium",
      "note": "It weighs 7 to 18 kg.",
      "source": "adw"
    },
    "diet": {
      "value": "insects",
      "note": "It eats mostly ants and termites.",
      "source": "adw"
    },
    "activity": {
      "value": "night",
