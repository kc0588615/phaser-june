      "value": "one",
      "note": "A mother usually has a single baby.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "It has no teeth. It swallows small stones that help grind up food in its stomach.",
      "tags": [
        "toothless"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its sticky tongue can be up to 25 cm long.",
      "tags": [
        "long_tongue"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It walks on its back legs, using its front legs and tail now and then for balance.",
      "tags": [
        "walks_upright"
      ],
      "source": "wikipedia"
    },
    {
      "category": "diet",
      "text": "It sniffs out ant and termite nests and tears them open with its long front claws.",
      "tags": [
        "raids_termite_mounds",
        "digging_claws"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "At the first sign of danger it rolls into a ball, wrapping its tail around its body.",
      "tags": [
        "rolls_into_ball"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It can dig its own burrow, but it prefers old ones left by warthogs or aardvarks.",
      "tags": [
        "burrower",
        "borrowed_burrows"
      ],
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "It marks trees with urine and scent to leave messages for other pangolins.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Babies ride on their mother's back or tail until they weigh about 3 kg.",
      "tags": [
        "carries_young_on_back",
        "mother_carries_young"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Trade in pangolins, and farms taking over its land, are its main threats.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the only pangolin in southern and eastern Africa.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "It is named after the Dutch zoologist Coenraad Jacob Temminck.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Its scales are made of keratin, the same stuff as your fingernails.",
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "Its burrows can be big enough for a person to crawl into.",
      "source": "wikipedia"
    },
    {
      "category": "life_description",
      "text": "A baby weighs 200 to 500 g at birth and starts finding its own food at about 3 months old.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Electric fences on farms are a growing danger to it across its range.",
      "source": "iucn"
    }
  ],
