  "traits": {
    "covering": {
      "value": "fur",
      "note": "Its short fur is so thin in places that its dark skin shows.",
      "source": "adw"
    },
    "size": {
      "value": "medium",
      "note": "It weighs 18 to 36 kg.",
      "source": "adw"
    },
    "diet": {
      "value": "meat",
      "note": "It hunts antelope like impala, and sometimes wildebeest and zebra.",
      "source": "adw"
    },
    "activity": {
      "value": "day",
      "note": "It hunts mostly in the morning and early evening, and on bright moonlit nights.",
      "source": "adw"
    },
    "social": {
      "value": "groups",
      "note": "Packs usually have 7 to 15 dogs.",
      "source": "adw"
    },
    "birth": {
      "value": "live",
      "source": "adw"
    },
    "young": {
      "value": "few",
      "note": "A litter has 2 to 20 pups, about 8 on average.",
      "source": "adw"
    },
    "lifespan": {
      "value": "medium",
      "note": "Wild dogs live about 10 to 11 years.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "Its coat is a patchwork of brown, red, black, yellow and white, and no two dogs have the same pattern.",
      "tags": [
        "patchy_coat"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has large, rounded ears.",
      "tags": [
        "big_ears"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its bushy tail has a white tip.",
      "tags": [
        "white_tail_tip"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has only four toes on each foot. Most dogs have a fifth, small toe on their front feet.",
      "tags": [
        "four_toes"
      ],
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "The pack hunts together, chasing prey for kilometres at up to 55 km/h until it tires.",
      "tags": [
        "pack_hunter",
        "fast_runner"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Pack members bring up food for the pups, and for sick or hurt dogs that stayed behind.",
      "tags": [
        "shares_food"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Pups are born in a den, often an old aardvark burrow.",
      "tags": [
        "borrowed_burrows"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "It needs huge areas, so it often wanders out of parks into farmland, snares and busy roads.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its scientific name, Lycaon pictus, means \"painted wolf\".",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "Before a hunt, pack members vote by sneezing: the more sneezes, the more likely the pack sets off.",
      "source": "literature",
      "url": "https://doi.org/10.1098/rspb.2017.1347"
    },
    {
      "category": "key_fact",
      "text": "It has more pups at a time than any other wild dog.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "It is the largest wild dog in Africa, and the only living species in its genus.",
      "source": "wikipedia"
    },
    {
      "category": "life_description",
      "text": "Only the top male and female in a pack usually breed, and the whole pack helps raise the pups.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Village dogs can pass deadly diseases on to wild dogs.",
      "source": "iucn"
    },
    {
      "category": "threat",
      "text": "Only about 1,700 adults that can breed are left.",
      "source": "iucn"
    }
  ],
