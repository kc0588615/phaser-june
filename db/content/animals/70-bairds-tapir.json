  "clues": [
    {
      "category": "morphology",
      "text": "Its nose and upper lip form a short, bendy trunk it uses to find and grab food.",
      "tags": [
        "trunk"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its large, oval ears have white edges, and its lips are white.",
      "tags": [
        "white_ear_rims"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It swims, wades and dives very well.",
      "tags": [
        "swimmer"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "In the dry season it sleeps in muddy pools of water.",
      "tags": [
        "mud_bather"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Its eyes are small and it sees poorly; it relies on smell and hearing.",
      "tags": [
        "poor_eyesight"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Tapirs call to each other with long, high whistles.",
      "tags": [
        "whistle_calls"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It eats fruit whenever it is in season.",
      "tags": [
        "fruit_eater"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "Its babies are reddish brown with white spots and stripes.",
      "tags": [
        "striped_young"
      ],
      "source": "wikipedia"
    },
    {
      "category": "conservation",
      "text": "People hunting it are its biggest danger.",
      "source": "adw"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the largest native land mammal in Central and South America.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "It is the national animal of Belize, where people call it the \"mountain cow\".",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "It is named after the American naturalist Spencer Fullerton Baird.",
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "At night it blends in with leafy bushes, and by day it can look like a big rock.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "A mother is pregnant for about 13 months, and her calf stays with her for 1 to 2 years.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "In southern Mexico, scientists counted about five times fewer tapirs where they are hunted a lot.",
      "source": "adw"
    }
  ],
