  "traits": {
    "covering": {
      "value": "skin",
      "note": "Its thick hide has only short, bristly hair.",
      "source": "adw"
    },
    "size": {
      "value": "large",
      "note": "It weighs 150 to 300 kg, about as much as a small donkey.",
      "source": "adw"
    },
    "diet": {
      "value": "plants",
      "note": "It eats mostly leaves, plus fruit, twigs, flowers and grass.",
      "source": "adw"
    },
    "activity": {
      "value": "night",
      "note": "It is sometimes active by day, but more at night where it is hunted.",
      "source": "adw"
    },
    "social": {
      "value": "alone",
      "source": "adw"
    },
    "trees": {
      "value": "no",
      "note": "It sleeps and feeds on the ground, reaching no higher than 1.5 meters.",
      "source": "adw"
    },
