  "clues": [
    {
      "category": "morphology",
      "text": "Cream or tan markings around its eyes can look like glasses, and each bear's pattern is different.",
      "tags": [
        "spectacles",
        "face_markings"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "It has the strongest chewing muscles, for its size, of any bear, for grinding tough plants.",
      "tags": [
        "strong_bite"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It is a great climber and spends lots of time in trees.",
      "tags": [
        "climber",
        "tree_dweller"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It builds platforms, like nests, in fruit trees, where it feeds and sleeps.",
      "tags": [
        "builds_nests"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Bromeliads, spiky plants of the pineapple family, are one of its main foods.",
      "tags": [
        "bromeliad_eater"
      ],
      "source": "wikipedia"
    },
    {
      "category": "diet",
      "text": "It has a strong liking for fruit.",
      "tags": [
        "fruit_eater"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in the Andes, from cloud forest up to the high grassland called páramo.",
      "tags": [
        "high_mountains"
      ],
      "source": "wikipedia"
    },
    {
      "category": "conservation",
      "text": "Farms, mining and oil drilling are cutting up its forests.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the only bear that lives in South America.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "It is also called the spectacled bear. Paddington Bear, who comes from Peru, is one.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "After the giant panda, it is probably the bear that eats the most plants.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "It is the last living short-faced bear.",
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "It doesn't hibernate.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Cubs weigh only about 300 g at birth, and are born with their eyes closed.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Bears that raid farmers' corn are sometimes shot.",
      "source": "adw"
    }
  ],
