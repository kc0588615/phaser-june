  "clues": [
    {
      "category": "morphology",
      "text": "Its long coat is golden red, with black legs and a black mane on its neck.",
      "tags": [
        "reddish_fur",
        "mane"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its very long, thin legs help it see over tall grass.",
      "tags": [
        "long_legs"
      ],
      "source": "wikipedia"
    },
    {
      "category": "morphology",
      "text": "It has big, upright ears.",
      "tags": [
        "big_ears"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Its favorite food is the wolf apple, a tomato-like fruit, and it spreads the seeds in its droppings.",
      "tags": [
        "fruit_eater",
        "seed_spreader"
      ],
      "source": "wikipedia"
    },
    {
      "category": "diet",
      "text": "It stalks small animals and pounces on them, like a fox.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Pairs mark the borders of their home with urine and droppings, and neighbors stay on their own side.",
      "tags": [
        "territorial",
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "After dusk it often gives a single loud, deep bark.",
      "tags": [
        "loud_calls"
      ],
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Big farms and ranches are replacing its grasslands.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It isn't a wolf or a fox. It is the only species in its genus, and its name means \"golden dog\".",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "It is the tallest wild dog in the world, and the largest in South America.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Its urine has such a strong smell that it is nicknamed the \"skunk wolf\".",
      "source": "wikipedia"
    },
    {
      "category": "life_description",
      "text": "Pups are born black and turn red by about 10 weeks old.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It rests in thick brush during the day.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "It often raids farms for free-ranging chickens, which angers farmers.",
      "source": "adw"
    }
  ],
