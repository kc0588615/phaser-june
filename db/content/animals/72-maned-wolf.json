  "clues": [
    {
      "category": "morphology",
      "text": "Its long coat is golden red, with black legs and a black mane on its neck.",
      "tags": [
        "reddish_fur",
        "mane"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its very long, thin legs help it see over tall grass.",
      "source": "wikipedia"
    },
    {
      "category": "morphology",
      "text": "It has big, upright ears.",
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "Its favorite food is the wolf apple, a tomato-like fruit, and it spreads the seeds in its droppings.",
      "source": "wikipedia"
    },
    {
      "category": "diet",
      "text": "It stalks small animals and pounces on them, like a fox.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "Pairs mark the borders of their home with urine and droppings, and neighbors stay on their own side.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "After dusk it often gives a single loud, deep bark.",
      "source": "adw"
    },
    {
      "category": "conservation",
      "text": "Big farms and ranches are replacing its grasslands.",
      "source": "iucn"
    },
    {
      "category": "morphology",
      "text": "Its face has bold markings in a contrasting color, such as patches, rings or lines.",
      "tags": [
        "face_markings"
      ],
      "source": "ngo",
      "url": "https://www.carnivoreconservation.org/files/actionplans/canids.pdf"
    },
    {
      "category": "morphology",
      "text": "Its snout is long, or narrows to a pointed tip.",
      "tags": [
        "pointed_snout"
      ],
      "source": "wikipedia"
    },
    {
      "category": "morphology",
      "text": "Its body is bright red-orange.",
      "tags": [
        "red_orange"
      ],
      "source": "ngo",
      "url": "https://www.carnivoreconservation.org/files/actionplans/canids.pdf"
    },
    {
      "category": "morphology",
      "text": "It has very sharp hearing and relies on it.",
      "tags": [
        "super_hearing"
      ],
      "source": "smithsonian",
      "url": "https://nationalzoo.si.edu/animals/maned-wolf"
    },
    {
      "category": "morphology",
      "text": "It has a patch of contrasting color on its throat.",
      "tags": [
        "throat_patch"
      ],
      "source": "wikipedia"
    },
    {
      "category": "morphology",
      "text": "Its tail ends in white, or has a white band near the end.",
      "tags": [
        "white_tail_tip"
      ],
      "source": "ngo",
      "url": "https://www.carnivoreconservation.org/files/actionplans/canids.pdf"
    },
    {
      "category": "morphology",
      "text": "Its legs are very long for its body.",
      "tags": [
        "long_legs"
      ],
      "source": "wikipedia"
    },
    {
      "category": "morphology",
      "text": "Its ears are large for its head.",
      "tags": [
        "big_ears"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It leaves its dung in piles that it comes back to, as messages to others of its kind.",
      "tags": [
        "dung_piles"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It finds most of its food on the ground.",
      "tags": [
        "feeds_on_ground"
      ],
      "source": "government",
      "url": "https://www.govinfo.gov/content/pkg/GOVPUB-SI-PURL-gpo55903/pdf/GOVPUB-SI-PURL-gpo55903.pdf"
    },
    {
      "category": "diet",
      "text": "Rodents are a main part of its prey.",
      "tags": [
        "rodent_hunter"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It shares food with, or brings food to, members of its group other than its own young.",
      "tags": [
        "shares_food"
      ],
      "source": "government",
      "url": "https://www.govinfo.gov/content/pkg/GOVPUB-SI-PURL-gpo55903/pdf/GOVPUB-SI-PURL-gpo55903.pdf"
    },
    {
      "category": "behavior",
      "text": "At least sometimes, it stands, rears up, hops or runs on its back legs alone.",
      "tags": [
        "stands_on_hind_legs"
      ],
      "source": "government",
      "url": "https://www.govinfo.gov/content/pkg/GOVPUB-SI-PURL-gpo55903/pdf/GOVPUB-SI-PURL-gpo55903.pdf"
    },
    {
      "category": "diet",
      "text": "It gathers food and stores it to eat later.",
      "tags": [
        "stores_food"
      ],
      "source": "government",
      "url": "https://www.govinfo.gov/content/pkg/GOVPUB-SI-PURL-gpo55903/pdf/GOVPUB-SI-PURL-gpo55903.pdf"
    },
    {
      "category": "diet",
      "text": "Fruit is a main or favorite part of its food.",
      "tags": [
        "fruit_eater"
      ],
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "It makes loud calls that carry far, such as songs, hoots, barks, roars or wails.",
      "tags": [
        "loud_calls"
      ],
      "source": "smithsonian",
      "url": "https://nationalzoo.si.edu/animals/maned-wolf"
    },
    {
      "category": "behavior",
      "text": "It marks its home area, paths or objects with scent, such as urine, dung or scent rubbed on from its glands.",
      "tags": [
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "diet",
      "text": "It spreads plant seeds to new places by eating them, often in fruit, and passing them in its droppings.",
      "tags": [
        "seed_spreader"
      ],
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "It defends an area, such as a territory, home patch or den site, against others of its kind.",
      "tags": [
        "territorial"
      ],
      "source": "wikipedia"
    },
    {
      "category": "habitat",
      "text": "In some places it lives in or near human settlements, such as towns, villages, gardens, parks or plantations.",
      "tags": [
        "town_dweller"
      ],
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It isn't a wolf or a fox. It is the only species in its genus, and its name means \"golden dog\".",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "It is the tallest wild dog in the world, and the largest in South America.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Its urine has such a strong smell that it is nicknamed the \"skunk wolf\".",
      "source": "wikipedia"
    },
    {
      "category": "life_description",
      "text": "Pups are born black and turn red by about 10 weeks old.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It rests in thick brush during the day.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "It often raids farms for free-ranging chickens, which angers farmers.",
      "source": "adw"
    }
  ],
