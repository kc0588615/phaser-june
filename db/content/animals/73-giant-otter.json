  "clues": [
    {
      "category": "morphology",
      "text": "It has webbed feet and a flat, wing-shaped tail for swimming.",
      "tags": [
        "swimmer",
        "webbed_feet",
        "paddle_tail"
      ],
      "source": "wikipedia"
    },
    {
      "category": "morphology",
      "text": "Each otter has its own pattern of cream patches on its throat.",
      "tags": [
        "throat_patch"
      ],
      "source": "wikipedia"
    },
    {
      "category": "diet",
      "text": "Families sometimes dive together to trap fish against the shore.",
      "tags": [
        "fish_eater",
        "pack_hunter"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It is the noisiest otter, with many different calls for alarm and for keeping in touch.",
      "tags": [
        "loud_calls"
      ],
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "Families clear campsites on riverbanks and mark their territory with scent and shared toilet spots.",
      "tags": [
        "territorial",
        "scent_marks"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It digs big dens under fallen logs near the water.",
      "tags": [
        "burrower"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in slow rivers, oxbow lakes and swamps, and moves into flooded forest in the wet season.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Gold mining poisons its rivers with mercury, and new dams change the rivers it needs.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the longest member of the weasel family, up to 1.8 m long.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "In Brazil it is called the \"water jaguar\", and in Spanish the \"river wolf\".",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Hunting for its velvety fur, mostly in the 1950s and 1960s, nearly wiped it out.",
      "source": "wikipedia"
    },
    {
      "category": "diet_prey",
      "text": "It eats about 3 to 4 kg of fish a day, mostly catfish and other river fish, and sometimes small caimans.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It eats small fish floating on its back, and carries big ones to shore.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Pups open their eyes at 1 month and hunt as well as their parents by 9 or 10 months.",
      "source": "adw"
    }
  ],
