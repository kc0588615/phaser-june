  "clues": [
    {
      "category": "morphology",
      "text": "Even as an adult it keeps feathery gills sticking out behind its head.",
      "tags": [
        "feathery_gills"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "A fin runs from the back of its head along its tail, like a tadpole's.",
      "source": "wikipedia"
    },
    {
      "category": "reproduction",
      "text": "It grows up and breeds without ever changing into a land form, like a tadpole that never becomes a frog.",
      "tags": [
        "stays_larval"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It lives its whole life under water.",
      "tags": [
        "fully_aquatic"
      ],
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "It can regrow lost legs, gills, and even parts of its eyes and brain.",
      "tags": [
        "regrows_body_parts"
      ],
      "source": "wikipedia"
    },
    {
      "category": "diet",
      "text": "It can sense the tiny electric fields of prey.",
      "tags": [
        "electric_sense"
      ],
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives only in the canals and lakes of Xochimilco and Chalco, inside Mexico City.",
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Tilapia, fish that people put in its lakes, hunt it and compete for its food.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "Its name comes from Nahuatl, the language of the Aztecs.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Since 2021 an axolotl has been on the back of Mexico's 50-peso banknote.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Its genome, the full set of its DNA, is about 10 times bigger than ours. It was the biggest animal genome ever read when it was published in 2018.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Huge numbers live in labs and homes around the world, but only 50 to 1,000 adults are left in the wild.",
      "source": "wikipedia"
    },
    {
      "category": "life_description",
      "text": "Its eggs hatch after 10 to 14 days, and the young look after themselves right away.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Surveys of Lake Xochimilco found about 6,000 per square kilometre in 1998, but only 100 in 2008.",
      "source": "wikipedia"
    }
  ],
