      "value": "eggs",
      "source": "adw"
    },
    "young": {
      "value": "many",
      "note": "A female lays 150 to 450 eggs.",
      "source": "adw"
    },
    "lifespan": {
      "value": "long",
      "note": "It can live up to 30 years.",
      "source": "adw"
    }
  },
  "clues": [
    {
      "category": "morphology",
      "text": "Its head and body are very flat, and it has no eyelids.",
      "tags": [
        "flat_body",
        "lidless_eyes"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Loose, wrinkly folds of skin along its sides help it breathe through its skin.",
      "tags": [
        "underwater_breathing"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It sees poorly. It senses movement in the water and smells its prey.",
      "tags": [
        "poor_eyesight",
        "senses_vibrations"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "By day it hides under a big flat rock on the stream bed, and it defends that rock from other hellbenders.",
      "tags": [
        "crevice_hider",
        "territorial"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It lives its whole life in the water.",
      "tags": [
        "fully_aquatic"
      ],
      "source": "adw"
    },
    {
      "category": "reproduction",
      "text": "The father digs a nest under a rock and guards the eggs.",
      "tags": [
        "egg_guarding"
      ],
      "source": "iucn"
    },
    {
      "category": "habitat",
      "text": "It needs clear, cool, fast-flowing streams, and avoids water warmer than 20 °C.",
      "tags": [
        "cold_streams"
      ],
      "source": "iucn"
    },
    {
      "category": "conservation",
      "text": "Mud washing in from logging, mining and roads buries the rocks it needs for shelter and nests.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the largest salamander in North America.",
      "source": "adw"
    },
    {
      "category": "key_fact",
      "text": "Its nicknames include \"snot otter\" and \"lasagna lizard\".",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Its closest relatives are the giant salamanders of China and Japan.",
      "source": "wikipedia"
    },
    {
      "category": "behavior",
      "text": "It takes in about 90% of its oxygen through its skin, so it needs water rich in oxygen.",
      "source": "iucn"
    },
    {
      "category": "behavior",
      "text": "A male can rock back and forth to move fresh water over its skin.",
      "source": "wikipedia"
    },
    {
      "category": "life_description",
      "text": "Eggs hatch after 45 to 80 days, and young hellbenders take 5 to 8 years to grow up.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Dams stop the fast flow of the streams it lives in.",
      "source": "iucn"
    }
  ],
