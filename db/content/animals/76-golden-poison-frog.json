  "clues": [
    {
      "category": "morphology",
      "text": "Its whole body is one bright color, usually yellow, but sometimes orange or pale green.",
      "tags": [
        "warning_colors"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "A bony plate in its jaw makes it look like it has teeth.",
      "tags": [
        "tooth_plate"
      ],
      "source": "adw"
    },
    {
      "category": "morphology",
      "text": "Its young are black with two gold stripes, which fade as they grow up.",
      "tags": [
        "striped_young"
      ],
      "source": "amphibiaweb"
    },
    {
      "category": "morphology",
      "text": "Its eyes and the tips of its toes are black.",
      "source": "amphibiaweb"
    },
    {
      "category": "behavior",
      "text": "It stays on the ground and hardly ever climbs.",
      "tags": [
        "forest_floor"
      ],
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "It isn't shy like other poison frogs; it has few enemies, so it doesn't hide.",
      "source": "adw"
    },
    {
      "category": "habitat",
      "text": "It lives in the leaf litter of very rainy forest.",
      "tags": [
        "leaf_litter"
      ],
      "source": "iucn"
    },
    {
      "category": "reproduction",
      "text": "The father carries the tadpoles to pools of water.",
      "tags": [
        "father_carries_young"
      ],
      "source": "iucn"
    },
    {
      "category": "geography",
      "text": "It lives only on the Pacific coast of Colombia.",
      "source": "amphibiaweb"
    },
    {
      "category": "conservation",
      "text": "Illegal crops, logging, mining and pollution are destroying its small forest.",
      "source": "iucn"
    }
  ],
  "facts": [
    {
      "category": "key_fact",
      "text": "It is the most poisonous of all frogs. One frog may hold enough poison to kill about 10 people.",
      "source": "amphibiaweb"
    },
    {
      "category": "key_fact",
      "text": "The Emberá people of Colombia use its poison on the darts they hunt with.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Its poison comes from its food. Frogs raised in zoos on crickets lose their poison.",
      "source": "wikipedia"
    },
    {
      "category": "key_fact",
      "text": "Hunters rub their blowgun darts on the skin of a live frog to load them with poison.",
      "source": "amphibiaweb"
    },
    {
      "category": "key_fact",
      "text": "Its poison might one day help make a medicine for pain.",
      "source": "amphibiaweb"
    },
    {
      "category": "behavior",
      "text": "Males sing to females with a long, musical trill.",
      "source": "adw"
    },
    {
      "category": "behavior",
      "text": "A father can carry up to nine tadpoles on his back at once.",
      "source": "amphibiaweb"
    },
    {
      "category": "diet_prey",
      "text": "It catches ants with a sticky tongue so fast the eye can barely follow it.",
      "source": "adw"
    },
    {
      "category": "threat",
      "text": "Only one enemy is known: a small snake that can eat young frogs without being harmed.",
      "source": "adw"
    },
    {
      "category": "life_description",
      "text": "Its tadpoles have no poison. It gets its poison only after it turns into a frog.",
      "source": "amphibiaweb"
    }
  ],
