# Runtime settings for the app container. Copy to deploy/app.env on the VPS
# (never commit it). Build-time NEXT_PUBLIC_* values go in the stack's .env.

# The least-privilege role (deploy/db/app-role.sql), straight to the db
# container on the internal network (no TLS needed inside it).
DATABASE_URL=postgres://critter_app:<password>@db:5432/phaser_june

# Clerk production instance (keys start with sk_live_ / pk_live_).
CLERK_SECRET_KEY=<sk_live_...>
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<pk_live_...>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# Habitat pictures on the place card (optional).
NEXT_PUBLIC_TITILER_BASE_URL=<https://titiler.example.org>
NEXT_PUBLIC_COG_URL=<https://.../habitat_cog.tif>
