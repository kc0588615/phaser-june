{
    "name": "critter-connect",
    "version": "1.2.0",
    "private": true,
    "description": "A biodiversity exploration and match-3 deduction game built with Phaser, Next.js, MapLibre, and Drizzle.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kc0588615/phaser-june.git"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/kc0588615/phaser-june/issues"
    },
    "homepage": "https://github.com/kc0588615/phaser-june#readme",
    "keywords": [
        "phaser",
        "phaser3",
        "next",
        "nextjs",
        "typescript",
        "maplibre",
        "biodiversity",
        "game"
    ],
    "engines": {
        "node": "22.x",
        "npm": ">=8.0.0"
    },
    "scripts": {
        "dev": "next dev -p 8080",
        "build": "npm run typecheck && next build",
        "serve": "next start -p 8080",
        "start": "npm run build && npm run serve",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src tests scripts",
        "test": "node scripts/run-tests.mjs",
        "typecheck:watch": "tsc --noEmit --watch",
        "clean": "rm -rf .next .test-dist",
        "db:introspect": "drizzle-kit introspect",
        "content": "node scripts/run-typescript.mjs scripts/content.ts",
        "clue:world-map": "node scripts/run-typescript.mjs scripts/clue-world-map.ts"
    },
    "dependencies": {
        "@clerk/nextjs": "^7.7.8",
        "drizzle-orm": "^0.45.2",
        "lucide-react": "^0.525.0",
        "maplibre-gl": "^5.19.0",
        "next": "^16.1.0",
        "phaser": "^3.90.0",
        "postgres": "^3.4.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.11",
        "@types/node": "^20",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "dotenv": "^17.2.3",
        "drizzle-kit": "^0.30.0",
        "eslint": "^9.33.0",
        "eslint-config-next": "^16.1.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.11",
        "typescript": "^5"
    }
}
