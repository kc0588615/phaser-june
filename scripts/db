#!/usr/bin/env node
// psql to the database DATABASE_URL names (the environment's, else .env.local's: the live phaser_june on WSL and the Oracle VPS), without credentials in argv.
//   ./scripts/db                      interactive shell
//   ./scripts/db "select 1;"          one-off query
//   ./scripts/db -f change.sql        run a file (stops on first error)
//   ./scripts/db --production -1 -f change.sql   same database, raw Postgres through the WSL SSH tunnel (127.0.0.1:55432)

const { existsSync } = require('node:fs');
const { resolve } = require('node:path');
const { spawnSync } = require('node:child_process');

const root = resolve(__dirname, '..');
const envPath = resolve(root, '.env.local');

if (!process.env.DATABASE_URL && existsSync(envPath)) {
  try {
    process.loadEnvFile(envPath);
  } catch (error) {
    console.error(`Could not load ${envPath}: ${error instanceof Error ? error.message : String(error)}`);
    process.exit(2);
  }
}

if (!process.env.DATABASE_URL) {
  console.error('DATABASE_URL is not set in the environment or .env.local.');
  process.exit(2);
}

let url;
try {
  url = new URL(process.env.DATABASE_URL);
} catch {
  console.error('DATABASE_URL is not a valid URL.');
  process.exit(2);
}

const userArgs = process.argv.slice(2);
// --production changes only the route (the WSL tunnel), not the database.
if (userArgs[0] === '--production') {
  userArgs.shift();
  url.hostname = '127.0.0.1';
  url.port = '55432';
  url.searchParams.set('sslmode', 'disable');
}

const database = decodeURIComponent(url.pathname.replace(/^\//, ''));
const user = decodeURIComponent(url.username);
const password = decodeURIComponent(url.password);
if (!url.hostname || !database || !user) {
  console.error('DATABASE_URL must include a host, database, and user.');
  process.exit(2);
}

const { DATABASE_URL: _databaseUrl, ...childEnv } = process.env;
Object.assign(childEnv, {
  PGHOST: url.hostname,
  PGPORT: url.port || '5432',
  PGDATABASE: database,
  PGUSER: user,
});
if (password) childEnv.PGPASSWORD = password;
const sslMode = url.searchParams.get('sslmode');
if (sslMode) childEnv.PGSSLMODE = sslMode;

const psqlArgs = ['-X'];
if (userArgs.length > 0) psqlArgs.push('-v', 'ON_ERROR_STOP=1', '-P', 'pager=off');
if (userArgs.length === 0) {
  // Interactive shell.
} else if (userArgs[0].startsWith('-')) {
  psqlArgs.push(...userArgs);
} else {
  psqlArgs.push('-c', userArgs.join(' '));
}

const result = spawnSync('psql', psqlArgs, { env: childEnv, stdio: 'inherit' });
if (result.error) {
  console.error(`Could not start psql: ${result.error.message}`);
  process.exit(2);
}
process.exit(result.status ?? 1);
